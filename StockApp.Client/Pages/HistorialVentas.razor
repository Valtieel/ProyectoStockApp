@page "/historial-ventas"
@inject HttpClient Http

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m19 9-5 5-4-4-3 3"></path></svg>
        </span>
        <div>
            <h1>Historial de ventas</h1>
            <div class="sa-page-sub">Consultá ventas pasadas por período</div>
        </div>
    </div>
</div>

<div class="sa-card" style="margin-bottom:24px;">
    <div style="display:flex;gap:24px;align-items:flex-end;flex-wrap:wrap;">
        <div>
            <label class="sa-label">Desde</label>
            <div class="sa-inline-fields" style="margin-top:7px;">
                <input class="sa-input" type="number" @bind="diaDesde" min="1" max="31" placeholder="Día" style="width:70px;" />
                <input class="sa-input" type="number" @bind="mesDesde" min="1" max="12" placeholder="Mes" style="width:70px;" />
                <input class="sa-input" type="number" @bind="anioDesde" min="2024" max="2099" placeholder="Año" style="width:90px;" />
            </div>
        </div>
        <div>
            <label class="sa-label">Hasta</label>
            <div class="sa-inline-fields" style="margin-top:7px;">
                <input class="sa-input" type="number" @bind="diaHasta" min="1" max="31" placeholder="Día" style="width:70px;" />
                <input class="sa-input" type="number" @bind="mesHasta" min="1" max="12" placeholder="Mes" style="width:70px;" />
                <input class="sa-input" type="number" @bind="anioHasta" min="2024" max="2099" placeholder="Año" style="width:90px;" />
            </div>
        </div>
        <button class="sa-btn sa-btn--primary" @onclick="CargarVentas">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            Buscar
        </button>
        <button class="sa-btn sa-btn--secondary" @onclick="CargarHoy">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Hoy
        </button>
    </div>
</div>

@if (cargando)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (ventas == null || !ventas.Any())
{
    <p style="color:var(--sa-sub);">No hay ventas en el período seleccionado.</p>
}
else
{
    <div class="sa-grid-2" style="margin-bottom:24px;">
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
            </span>
            <div>
                <div class="sa-stat-value">@ventas.Count</div>
                <div class="sa-stat-label">Ventas</div>
            </div>
        </div>
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico sa-stat-ico--ok">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </span>
            <div>
                <div class="sa-stat-value">$@ventas.Sum(v => v.Total)</div>
                <div class="sa-stat-label">Total recaudado</div>
            </div>
        </div>
    </div>

    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Productos</th>
                    <th>Método de pago</th>
                    <th class="sa-right">Total</th>
                    <th class="sa-center"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in ventas)
                {
                    <tr>
                        <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@v.Fecha.ToString("HH:mm")</td>
                        <td>@v.Detalles.Count producto(s)</td>
                        <td class="sa-strong">@v.MetodoPago</td>
                        <td class="sa-right sa-num">$@v.Total</td>
                        <td class="sa-center">
                            <button class="sa-btn sa-btn--soft sa-btn--sm" @onclick="() => ToggleDetalle(v.Id)">
                                @if (ventaExpandida == v.Id)
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                                    <span>Cerrar</span>
                                }
                                else
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    <span>Ver detalle</span>
                                }
                            </button>
                        </td>
                    </tr>
                    @if (ventaExpandida == v.Id)
                    {
                        <tr class="sa-row--detalle">
                            <td colspan="6">
                                <table class="sa-subtable">
                                    <thead>
                                        <tr>
                                            <th>Producto</th>
                                            <th>Cantidad</th>
                                            <th>Precio unitario</th>
                                            <th>Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in v.Detalles)
                                        {
                                            <tr>
                                                <td>@d.Producto?.Nombre</td>
                                                <td>@d.Cantidad</td>
                                                <td>$@d.PrecioUnitario</td>
                                                <td>$@(d.Cantidad * d.PrecioUnitario)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<VentaDto>? ventas;
    private bool cargando = false;
    private int? ventaExpandida;

    private int diaDesde = 1;
    private int mesDesde = DateTime.Now.Month;
    private int anioDesde = DateTime.Now.Year;
    private int diaHasta = DateTime.Now.Day;
    private int mesHasta = DateTime.Now.Month;
    private int anioHasta = DateTime.Now.Year;

    protected override async Task OnInitializedAsync()
    {
        await CargarHoy();
    }

    private async Task CargarHoy()
    {
        diaDesde = DateTime.Now.Day;
        mesDesde = DateTime.Now.Month;
        anioDesde = DateTime.Now.Year;
        diaHasta = DateTime.Now.Day;
        mesHasta = DateTime.Now.Month;
        anioHasta = DateTime.Now.Year;
        await CargarVentas();
    }

    private async Task CargarVentas()
    {
        cargando = true;
        ventas = await Http.GetFromJsonAsync<List<VentaDto>>("ventas") ?? new();

        try
        {
            var desde = new DateTime(anioDesde, mesDesde, diaDesde);
            var hasta = new DateTime(anioHasta, mesHasta, diaHasta, 23, 59, 59);
            ventas = ventas.Where(v => v.Fecha >= desde && v.Fecha <= hasta)
                           .OrderByDescending(v => v.Fecha)
                           .ToList();
        }
        catch
        {
            ventas = new();
        }

        cargando = false;
    }

    private void ToggleDetalle(int id)
    {
        ventaExpandida = ventaExpandida == id ? null : id;
    }

    public class VentaDto
    {
        public int Id { get; set; }
        public decimal Total { get; set; }
        public string MetodoPago { get; set; } = string.Empty;
        public DateTime Fecha { get; set; }
        public List<DetalleDto> Detalles { get; set; } = new();
    }

    public class DetalleDto
    {
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public ProductoDto? Producto { get; set; }
    }

    public class ProductoDto
    {
        public string Nombre { get; set; } = string.Empty;
    }
}