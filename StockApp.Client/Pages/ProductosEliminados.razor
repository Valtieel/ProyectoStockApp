@page "/productos-eliminados"
@inject HttpClient Http

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        </span>
        <div>
            <h1>Productos eliminados</h1>
            <div class="sa-page-sub">Podés restaurarlos cuando quieras</div>
        </div>
    </div>
    <div class="sa-page-actions">
        <a href="productos" class="sa-btn sa-btn--secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"></path><polyline points="12 19 5 12 12 5"></polyline></svg>
            Volver a Productos
        </a>
    </div>
</div>

@if (cargando)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (!productos.Any())
{
    <div class="sa-alert-row sa-feedback sa-feedback--ok" style="max-width:520px;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>No hay productos eliminados.</span>
    </div>
}
else
{
    <div class="sa-banner" style="max-width:700px;margin-bottom:16px;">
        <span class="sa-banner-ico">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </span>
        <div>
            <div style="font:600 14px var(--sa-font);color:var(--sa-ink);">Productos con soft delete</div>
            <div style="font:500 12.5px var(--sa-font);color:var(--sa-sub);">Estos productos fueron eliminados pero sus datos se conservaron. Podés restaurarlos cuando quieras.</div>
        </div>
    </div>

    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="sa-right">Precio</th>
                    <th class="sa-right">Stock</th>
                    <th class="sa-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in productos)
                {
                    <tr style="opacity:0.7;">
                        <td class="sa-strong">@p.Nombre</td>
                        <td>@(p.CategoriaNombre ?? "-")</td>
                        <td class="sa-right sa-num">$@p.PrecioVenta</td>
                        <td class="sa-right sa-num">@p.StockActual</td>
                        <td class="sa-center">
                            <button class="sa-btn sa-btn--ok-soft sa-btn--sm" @onclick="() => Restaurar(p.Id)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                                Restaurar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback sa-feedback--ok" style="max-width:700px;margin-top:16px;">@mensaje</div>
}

@code {
    private List<ProductoDto> productos = new();
    private bool cargando = true;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        cargando = true;
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos/eliminados") ?? new();
        cargando = false;
    }

    private async Task Restaurar(int id)
    {
        var response = await Http.PostAsJsonAsync($"productos/{id}/restaurar", new { });

        if (response.IsSuccessStatusCode)
        {
            mensaje = "✅ Producto restaurado correctamente.";
            await CargarProductos();
        }
        else
        {
            mensaje = "❌ Error al restaurar el producto.";
        }
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? CategoriaNombre { get; set; }
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
    }
}