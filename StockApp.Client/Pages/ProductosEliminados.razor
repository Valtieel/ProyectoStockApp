@page "/productos-eliminados"
@inject HttpClient Http

<h3>♻️ Productos Eliminados</h3>

<a href="productos" class="btn-volver">← Volver a Productos</a>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!productos.Any())
{
    <p class="vacio">No hay productos eliminados.</p>
}
else
{
    <p class="info">Estos productos fueron eliminados pero sus datos se conservaron. Podés restaurarlos cuando quieras.</p>

    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in productos)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@(p.CategoriaNombre ?? "-")</td>
                    <td>$@p.PrecioVenta</td>
                    <td>@p.StockActual</td>
                    <td>
                        <button class="btn-restaurar" @onclick="() => Restaurar(p.Id)">
                            ♻️ Restaurar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <p class="mensaje">@mensaje</p>
}

@code {
    private List<ProductoDto> productos = new();
    private bool cargando = true;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        cargando = true;
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos/eliminados") ?? new();
        cargando = false;
    }

    private async Task Restaurar(int id)
    {
        var response = await Http.PostAsJsonAsync($"productos/{id}/restaurar", new { });

        if (response.IsSuccessStatusCode)
        {
            mensaje = "Producto restaurado correctamente.";
            await CargarProductos();
        }
        else
        {
            mensaje = "Error al restaurar el producto.";
        }
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? CategoriaNombre { get; set; }
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
    }
}

<style>
    h3 { margin-bottom: 1rem; }

    .btn-volver {
        display: inline-block;
        margin-bottom: 1rem;
        color: #3498db;
        text-decoration: none;
        font-weight: 600;
    }

    .info {
        background: #eaf4fb;
        border-left: 4px solid #3498db;
        padding: 10px 16px;
        border-radius: 6px;
        margin-bottom: 1rem;
        font-size: 14px;
    }

    .vacio {
        color: #777;
        font-style: italic;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    th, td {
        padding: 10px 14px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    th {
        background-color: #f4f4f4;
        font-weight: 600;
    }

    tr:hover { background-color: #f9f9f9; }

    .btn-restaurar {
        background-color: #2ecc71;
        color: white;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
    }

    .mensaje {
        margin-top: 1rem;
        font-weight: 600;
        color: #27ae60;
    }
</style>