@page "/categorias"
@inject IJSRuntime JS
@inject HttpClient Http
<AdminOnly>
<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
        </span>
        <div>
            <h1>Categorías</h1>
            <div class="sa-page-sub">Organización de productos</div>
        </div>
    </div>
    <div class="sa-page-actions">
        <button class="sa-btn sa-btn--primary" @onclick="MostrarFormulario">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            Nueva categoría
        </button>
    </div>
</div>

@if (mostrarFormulario)
{
    <div class="sa-card" style="margin-bottom:20px;max-width:480px;">
        <div class="sa-card-title" style="margin-bottom:16px;">
            @(categoriaEditando.Id == 0 ? "Nueva categoría" : "Editar categoría")
        </div>
        <div class="sa-field">
            <label class="sa-label">Nombre</label>
            <input class="sa-input" @bind="categoriaEditando.Nombre" placeholder="Ej: Bebidas" />
        </div>
        <div class="sa-field">
            <label class="sa-label">Descripción (opcional)</label>
            <input class="sa-input" @bind="categoriaEditando.Descripcion" placeholder="Ej: Gaseosas, aguas, jugos" />
        </div>
        <div style="display:flex;gap:10px;margin-top:6px;">
            <button class="sa-btn sa-btn--primary" @onclick="GuardarCategoria">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Guardar
            </button>
            <button class="sa-btn sa-btn--secondary" @onclick="CancelarFormulario">Cancelar</button>
        </div>
    </div>
}

@if (categorias == null)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (!categorias.Any())
{
    <p style="color:var(--sa-sub);">No hay categorías cargadas.</p>
}
else
{
    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="sa-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in categorias)
                {
                    <tr>
                        <td class="sa-strong">@c.Nombre</td>
                        <td>@(string.IsNullOrEmpty(c.Descripcion) ? "-" : c.Descripcion)</td>
                        <td class="sa-center">
                            <button class="sa-icbtn" title="Editar" @onclick="() => Editar(c)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                            </button>
                            <button class="sa-icbtn sa-icbtn--danger" title="Eliminar" @onclick="() => Eliminar(c.Id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(mensaje.StartsWith("❌") ? "sa-feedback--error" : "sa-feedback--ok")" style="max-width:480px;">@mensaje</div>
}
</AdminOnly>
@code {
    private List<CategoriaDto>? categorias;
    private CategoriaDto categoriaEditando = new();
    private bool mostrarFormulario = false;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("categorias");
    }

    private void MostrarFormulario()
    {
        categoriaEditando = new CategoriaDto();
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        categoriaEditando = new CategoriaDto();
    }

    private void Editar(CategoriaDto c)
    {
        categoriaEditando = new CategoriaDto
        {
            Id = c.Id,
            Nombre = c.Nombre,
            Descripcion = c.Descripcion
        };
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

   private async Task GuardarCategoria()
{
    if (string.IsNullOrWhiteSpace(categoriaEditando.Nombre))
    {
        mensaje = "❌ El nombre de la categoría es obligatorio.";
        return;
    }

    categoriaEditando.Activo = true;

    if (categoriaEditando.Id == 0)
    {
        await Http.PostAsJsonAsync("categorias", categoriaEditando);
        mensaje = "✅ Categoria creada correctamente.";
    }
    else
    {
        await Http.PutAsJsonAsync($"categorias/{categoriaEditando.Id}", categoriaEditando);
        mensaje = "✅ Categoria actualizada correctamente.";
    }

    mostrarFormulario = false;
    await CargarCategorias();
}

  private async Task Eliminar(int id)
{
    var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que querés eliminar esta categoría?");
    if (!confirmado) return;

    await Http.DeleteAsync($"categorias/{id}");
    mensaje = "Categoria eliminada.";
    await CargarCategorias();
}
    public class CategoriaDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Descripcion { get; set; }
        public bool Activo { get; set; } = true;
    }
}