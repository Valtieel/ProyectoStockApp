@page "/categorias"
@inject IJSRuntime JS
@inject HttpClient Http
<AdminOnly>
<h3>🗂️ Categorías</h3>

<button class="btn-nuevo" @onclick="MostrarFormulario">+ Nueva Categoría</button>

@if (mostrarFormulario)
{
    <div class="formulario">
        <h4>@(categoriaEditando.Id == 0 ? "Nueva Categoría" : "Editar Categoría")</h4>
        <div class="campo">
            <label>Nombre</label>
            <input @bind="categoriaEditando.Nombre" placeholder="Ej: Bebidas" />
        </div>
        <div class="campo">
            <label>Descripción (opcional)</label>
            <input @bind="categoriaEditando.Descripcion" placeholder="Ej: Gaseosas, aguas, jugos" />
        </div>
        <div class="botones">
            <button class="btn-guardar" @onclick="GuardarCategoria">💾 Guardar</button>
            <button class="btn-cancelar" @onclick="CancelarFormulario">Cancelar</button>
        </div>
    </div>
}

@if (categorias == null)
{
    <p>Cargando...</p>
}
else if (!categorias.Any())
{
    <p>No hay categorías cargadas.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in categorias)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>@(string.IsNullOrEmpty(c.Descripcion) ? "-" : c.Descripcion)</td>
                    <td>
                        <button class="btn-editar" @onclick="() => Editar(c)">✏️</button>
                        <button class="btn-eliminar" @onclick="() => Eliminar(c.Id)">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <p class="mensaje">@mensaje</p>
}
</AdminOnly>
@code {
    private List<CategoriaDto>? categorias;
    private CategoriaDto categoriaEditando = new();
    private bool mostrarFormulario = false;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("categorias");
    }

    private void MostrarFormulario()
    {
        categoriaEditando = new CategoriaDto();
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        categoriaEditando = new CategoriaDto();
    }

    private void Editar(CategoriaDto c)
    {
        categoriaEditando = new CategoriaDto
        {
            Id = c.Id,
            Nombre = c.Nombre,
            Descripcion = c.Descripcion
        };
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

   private async Task GuardarCategoria()
{
    if (string.IsNullOrWhiteSpace(categoriaEditando.Nombre))
    {
        mensaje = "❌ El nombre de la categoría es obligatorio.";
        return;
    }

    categoriaEditando.Activo = true;

    if (categoriaEditando.Id == 0)
    {
        await Http.PostAsJsonAsync("categorias", categoriaEditando);
        mensaje = "✅ Categoria creada correctamente.";
    }
    else
    {
        await Http.PutAsJsonAsync($"categorias/{categoriaEditando.Id}", categoriaEditando);
        mensaje = "✅ Categoria actualizada correctamente.";
    }

    mostrarFormulario = false;
    await CargarCategorias();
}

  private async Task Eliminar(int id)
{
    var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que querés eliminar esta categoría?");
    if (!confirmado) return;

    await Http.DeleteAsync($"categorias/{id}");
    mensaje = "Categoria eliminada.";
    await CargarCategorias();
}
    public class CategoriaDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Descripcion { get; set; }
        public bool Activo { get; set; } = true;
    }
}

<style>
    h3 { margin-bottom: 1rem; }

    .btn-nuevo {
        background-color: #2ecc71;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        margin-bottom: 1rem;
    }

    .formulario {
        background: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        max-width: 500px;
    }

    .campo {
        margin-bottom: 0.8rem;
        display: flex;
        flex-direction: column;
    }

    .campo label {
        font-weight: 600;
        margin-bottom: 4px;
        font-size: 14px;
    }

    .campo input {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
    }

    .botones {
        display: flex;
        gap: 10px;
        margin-top: 1rem;
    }

    .btn-guardar {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
    }

    .btn-cancelar {
        background-color: #95a5a6;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    th, td {
        padding: 10px 14px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    th {
        background-color: #f4f4f4;
        font-weight: 600;
    }

    tr:hover { background-color: #f9f9f9; }

    .btn-editar, .btn-eliminar {
        border: none;
        background: none;
        cursor: pointer;
        font-size: 18px;
        padding: 4px;
    }

    .mensaje {
        margin-top: 1rem;
        font-weight: 600;
        color: #27ae60;
    }
</style>