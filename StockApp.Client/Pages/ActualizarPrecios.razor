@page "/actualizar-precios"
@inject HttpClient Http
<AdminOnly>

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </span>
        <div>
            <h1>Actualizar precios</h1>
            <div class="sa-page-sub">Ajuste masivo por porcentaje</div>
        </div>
    </div>
</div>

<div class="sa-card" style="max-width:680px;">
    <p style="font:500 14px var(--sa-font);color:var(--sa-sub);margin:0 0 18px;">
        Actualizá el precio de <strong style="color:var(--sa-ink);">todos los productos</strong> de una sola vez ingresando un porcentaje.
    </p>

    <div class="sa-field">
        <label class="sa-label">Porcentaje de ajuste</label>
        <div class="sa-input-symbol">
            <input class="sa-input" type="number" @bind="porcentaje" placeholder="Ej: 10" />
            <span>%</span>
        </div>
        <small>
            Usá números positivos para subir (ej: 10 = +10%) y negativos para bajar (ej: -5 = -5%).
        </small>
    </div>

    @if (productos.Any())
    {
        <div class="sa-card-title" style="font-size:14.5px;margin:18px 0 10px;">Vista previa del cambio</div>
        <div class="sa-card sa-card--flush" style="box-shadow:none;border:1px solid var(--sa-border);margin-bottom:16px;">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="sa-right">Precio actual</th>
                        <th class="sa-right">Precio nuevo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in productos)
                    {
                        var precioNuevo = Math.Round(p.PrecioVenta + (p.PrecioVenta * (porcentaje / 100)), 2);
                        <tr>
                            <td class="sa-strong">@p.Nombre</td>
                            <td class="sa-right sa-num">$@p.PrecioVenta</td>
                            <td class="sa-right sa-num @(porcentaje > 0 ? "sa-text-danger" : porcentaje < 0 ? "sa-text-ok" : "")">
                                $@precioNuevo
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button class="sa-btn sa-btn--primary sa-btn--lg sa-btn--full" @onclick="AplicarCambioPrecios">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Aplicar cambio a todos los productos
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(mensaje.StartsWith("❌") ? "sa-feedback--error" : "sa-feedback--ok")" style="max-width:680px;">@mensaje</div>
}
</AdminOnly>

@code {
    private List<ProductoDto> productos = new();
    private decimal porcentaje = 0;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos") ?? new();
    }

    private async Task AplicarCambioPrecios()
    {
        if (porcentaje == 0)
        {
            mensaje = "Ingresá un porcentaje distinto de 0.";
            return;
        }

        var response = await Http.PostAsJsonAsync("productos/actualizar-precios", porcentaje);

        if (response.IsSuccessStatusCode)
        {
            mensaje = $"✅ Precios actualizados correctamente con un {porcentaje}%.";
            await CargarProductos();
        }
        else
        {
            mensaje = "❌ Error al actualizar los precios.";
        }
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal PrecioVenta { get; set; }
    }
}