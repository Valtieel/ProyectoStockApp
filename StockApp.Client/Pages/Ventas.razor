@page "/ventas"
@inject HttpClient Http
@inject IJSRuntime JS

<h3>💰 Ventas</h3>

<div class="panel">
    <h4>Nueva Venta</h4>

    @if (!cajaAbierta)
    {
        <p class="alerta">⚠️ No hay caja abierta. Abrí la caja antes de registrar ventas.</p>
    }
    else
    {
        <div class="campo">
            <label>Método de pago</label>
            <select @bind="metodoPago">
                <option value="efectivo">💵 Efectivo</option>
                <option value="transferencia">🏦 Transferencia</option>
                <option value="tarjeta">💳 Tarjeta</option>
            </select>
        </div>

        <h5>Productos</h5>
        <div class="agregar-producto">
            <select @bind="productoSeleccionadoId">
                <option value="0">-- Seleccioná un producto --</option>
                @foreach (var p in productos)
                {
                    <option value="@p.Id">@p.Nombre — $@p.PrecioVenta (Stock: @p.StockActual)</option>
                }
            </select>
            <input type="number" @bind="cantidadSeleccionada" min="1" placeholder="Cantidad" />
            <button class="btn-agregar" @onclick="AgregarItem">+ Agregar</button>
        </div>

        @if (items.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.NombreProducto</td>
                            <td>$@item.PrecioUnitario</td>
                            <td>@item.Cantidad</td>
                            <td>$@(item.PrecioUnitario * item.Cantidad)</td>
                            <td><button class="btn-quitar" @onclick="() => QuitarItem(item)">✖</button></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="total">
                <span>TOTAL:</span>
                <strong>$@items.Sum(i => i.PrecioUnitario * i.Cantidad)</strong>
            </div>

            <button class="btn-cobrar" @onclick="RegistrarVenta">✅ Cobrar</button>
        }
    }
</div>

@if (ultimaVenta != null)
{
    <div class="ticket" id="ticket-imprimir">
        <div class="ticket-header">
            <h2>@nombreNegocio</h2>
            @if (!string.IsNullOrEmpty(direccionNegocio))
            {
                <p>@direccionNegocio</p>
            }
            @if (!string.IsNullOrEmpty(telefonoNegocio))
            {
                <p>@telefonoNegocio</p>
            }
            <p>@ultimaVenta.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <hr />
        <table class="ticket-tabla">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cant.</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ultimaVenta.Items)
                {
                    <tr>
                        <td>@item.NombreProducto</td>
                        <td>@item.Cantidad</td>
                        <td>$@item.PrecioUnitario</td>
                        <td>$@(item.PrecioUnitario * item.Cantidad)</td>
                    </tr>
                }
            </tbody>
        </table>
        <hr />
        <div class="ticket-total">
            <span>TOTAL:</span>
            <strong>$@ultimaVenta.Total</strong>
        </div>
        <div class="ticket-pago">
            Método de pago: @ultimaVenta.MetodoPago
        </div>
        <hr />
        <p class="ticket-footer">¡Gracias por su compra!</p>
        <button class="btn-imprimir no-print" @onclick="Imprimir">🖨️ Imprimir ticket</button>
        <button class="btn-cerrar-ticket no-print" @onclick="CerrarTicket">✖ Cerrar</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <p class="mensaje">@mensaje</p>
}

@code {
    private List<ProductoDto> productos = new();
    private List<VentaItem> items = new();
    private string metodoPago = "efectivo";
    private int productoSeleccionadoId = 0;
    private int cantidadSeleccionada = 1;
    private bool cajaAbierta = false;
    private string mensaje = string.Empty;
    private TicketData? ultimaVenta;

    private string nombreNegocio = "StockApp";
    private string direccionNegocio = string.Empty;
    private string telefonoNegocio = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos") ?? new();

        try
        {
            var caja = await Http.GetFromJsonAsync<object>("cajas/actual");
            cajaAbierta = caja != null;
        }
        catch
        {
            cajaAbierta = false;
        }

        try
        {
            var nombre = await Http.GetFromJsonAsync<ConfigDto>("configuracion/NombreNegocio");
            var direccion = await Http.GetFromJsonAsync<ConfigDto>("configuracion/DireccionNegocio");
            var telefono = await Http.GetFromJsonAsync<ConfigDto>("configuracion/TelefonoNegocio");

            nombreNegocio = !string.IsNullOrEmpty(nombre?.Valor) ? nombre!.Valor : "StockApp";
            direccionNegocio = direccion?.Valor ?? string.Empty;
            telefonoNegocio = telefono?.Valor ?? string.Empty;
        }
        catch { }
    }

    private void AgregarItem()
    {
        if (productoSeleccionadoId == 0 || cantidadSeleccionada <= 0) return;

        var producto = productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);
        if (producto == null) return;

        var existente = items.FirstOrDefault(i => i.ProductoId == productoSeleccionadoId);
        if (existente != null)
        {
            existente.Cantidad += cantidadSeleccionada;
        }
        else
        {
            items.Add(new VentaItem
            {
                ProductoId = producto.Id,
                NombreProducto = producto.Nombre,
                PrecioUnitario = producto.PrecioVenta,
                Cantidad = cantidadSeleccionada
            });
        }

        productoSeleccionadoId = 0;
        cantidadSeleccionada = 1;
    }

    private void QuitarItem(VentaItem item)
    {
        items.Remove(item);
    }

    private async Task RegistrarVenta()
    {
        if (!items.Any()) return;

        var request = new
        {
            MetodoPago = metodoPago,
            Items = items.Select(i => new { i.ProductoId, i.Cantidad }).ToList()
        };

        var response = await Http.PostAsJsonAsync("ventas", request);

        if (response.IsSuccessStatusCode)
        {
            ultimaVenta = new TicketData
            {
                Fecha = DateTime.Now,
                MetodoPago = metodoPago,
                Total = items.Sum(i => i.PrecioUnitario * i.Cantidad),
                Items = items.ToList()
            };

            mensaje = $"✅ Venta registrada por ${ultimaVenta.Total}";
            items.Clear();
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos") ?? new();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"❌ {error}";
        }
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("imprimirTicket");
    }

    private void CerrarTicket()
    {
        ultimaVenta = null;
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
    }

    public class VentaItem
    {
        public int ProductoId { get; set; }
        public string NombreProducto { get; set; } = string.Empty;
        public decimal PrecioUnitario { get; set; }
        public int Cantidad { get; set; }
    }

    public class TicketData
    {
        public DateTime Fecha { get; set; }
        public string MetodoPago { get; set; } = string.Empty;
        public decimal Total { get; set; }
        public List<VentaItem> Items { get; set; } = new();
    }

    public class ConfigDto
    {
        public string Clave { get; set; } = string.Empty;
        public string Valor { get; set; } = string.Empty;
    }
}

<style>
    h3 { margin-bottom: 1rem; }

    .panel {
        background: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 1.5rem;
        max-width: 700px;
        margin-bottom: 1.5rem;
    }

    .campo {
        margin-bottom: 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .campo label {
        font-weight: 600;
        font-size: 14px;
    }

    .campo select {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
    }

    .agregar-producto {
        display: flex;
        gap: 10px;
        margin-bottom: 1rem;
        align-items: center;
    }

    .agregar-producto select {
        flex: 1;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
    }

    .agregar-producto input {
        width: 80px;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
    }

    .btn-agregar {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 15px;
        cursor: pointer;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
    }

    th, td {
        padding: 8px 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    th { background-color: #f4f4f4; font-weight: 600; }

    .btn-quitar {
        background: none;
        border: none;
        color: #e74c3c;
        cursor: pointer;
        font-size: 16px;
    }

    .total {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 1rem;
    }

    .btn-cobrar {
        background-color: #2ecc71;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-size: 18px;
        cursor: pointer;
        width: 100%;
    }

    .alerta {
        color: #e67e22;
        font-weight: 600;
    }

    .ticket {
        background: white;
        border: 2px dashed #ccc;
        border-radius: 10px;
        padding: 1.5rem;
        max-width: 400px;
        margin-top: 1.5rem;
        font-family: monospace;
    }

    .ticket-header {
        text-align: center;
    }

    .ticket-header h2 {
        margin: 0;
        font-size: 22px;
    }

    .ticket-header p {
        color: #777;
        font-size: 13px;
        margin: 4px 0;
    }

    .ticket-tabla {
        width: 100%;
        font-size: 13px;
    }

    .ticket-tabla th, .ticket-tabla td {
        padding: 4px 6px;
        border: none;
        border-bottom: 1px dotted #ddd;
    }

    .ticket-total {
        display: flex;
        justify-content: space-between;
        font-size: 18px;
        font-weight: bold;
        margin: 8px 0;
    }

    .ticket-pago {
        font-size: 13px;
        color: #555;
        margin-bottom: 8px;
    }

    .ticket-footer {
        text-align: center;
        font-size: 13px;
        color: #777;
    }

    .btn-imprimir {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
        margin-top: 10px;
        margin-right: 8px;
    }

    .btn-cerrar-ticket {
        background-color: #95a5a6;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
        margin-top: 10px;
    }

    .mensaje {
        font-weight: 600;
        color: #27ae60;
        margin-top: 1rem;
    }

    @@media print {
        .no-print { display: none !important; }
        .panel { display: none !important; }
        .mensaje { display: none !important; }
        .ticket {
            border: none;
            max-width: 100%;
        }
    }
</style>