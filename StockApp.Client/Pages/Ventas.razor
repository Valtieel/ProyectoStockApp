@page "/ventas"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="sa-page-head sa-print-hide">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
        </span>
        <div>
            <h1>Ventas</h1>
            <div class="sa-page-sub">Registrar una nueva venta</div>
        </div>
    </div>
</div>

<div class="sa-card sa-print-hide" style="max-width:700px;">
    <div class="sa-card-title" style="margin-bottom:16px;">Nueva venta</div>

    @if (!cajaAbierta)
    {
        <div class="sa-banner">
            <span class="sa-banner-ico">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </span>
            <div>
                <div style="font:600 14px var(--sa-font);color:var(--sa-ink);">No hay caja abierta</div>
                <div style="font:500 12.5px var(--sa-font);color:var(--sa-sub);">Abrí la caja antes de registrar ventas.</div>
            </div>
        </div>
    }
    else
    {
        <div class="sa-field">
            <label class="sa-label">Método de pago</label>
            <select class="sa-select" @bind="metodoPago" style="max-width:280px;">
                <option value="efectivo">Efectivo</option>
                <option value="transferencia">Transferencia</option>
                <option value="tarjeta">Tarjeta</option>
            </select>
        </div>

        <div class="sa-card-title" style="font-size:14.5px;margin:18px 0 10px;">Productos</div>
        <div class="sa-add-row">
            <select class="sa-select" @bind="productoSeleccionadoId">
                <option value="0">-- Seleccioná un producto --</option>
                @foreach (var p in productos)
                {
                    <option value="@p.Id">@p.Nombre — $@p.PrecioVenta (Stock: @p.StockActual)</option>
                }
            </select>
            <input class="sa-input" type="number" @bind="cantidadSeleccionada" min="1" placeholder="Cant." />
            <button class="sa-btn sa-btn--primary" @onclick="AgregarItem">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                Agregar
            </button>
        </div>

        @if (items.Any())
        {
            <div class="sa-card sa-card--flush" style="box-shadow:none;border:1px solid var(--sa-border);">
                <table class="sa-table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="sa-right">Precio</th>
                            <th class="sa-right">Cantidad</th>
                            <th class="sa-right">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td class="sa-strong">@item.NombreProducto</td>
                                <td class="sa-right sa-num">$@item.PrecioUnitario</td>
                                <td class="sa-right sa-num">@item.Cantidad</td>
                                <td class="sa-right sa-num">$@(item.PrecioUnitario * item.Cantidad)</td>
                                <td class="sa-center">
                                    <button class="sa-icbtn sa-icbtn--danger" @onclick="() => QuitarItem(item)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="M6 6l12 12"></path></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="sa-total-row">
                <span>TOTAL:</span>
                <strong>$@items.Sum(i => i.PrecioUnitario * i.Cantidad)</strong>
            </div>

            <button class="sa-btn sa-btn--primary sa-btn--lg sa-btn--full" @onclick="RegistrarVenta">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                Cobrar
            </button>
        }
    }
</div>

@if (ultimaVenta != null)
{
    <div class="sa-ticket" id="ticket-imprimir">
        <div class="sa-ticket-header">
            <h2>@nombreNegocio</h2>
            @if (!string.IsNullOrEmpty(direccionNegocio))
            {
                <p>@direccionNegocio</p>
            }
            @if (!string.IsNullOrEmpty(telefonoNegocio))
            {
                <p>@telefonoNegocio</p>
            }
            <p>@ultimaVenta.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <hr />
        <table class="sa-ticket-tabla">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cant.</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ultimaVenta.Items)
                {
                    <tr>
                        <td>@item.NombreProducto</td>
                        <td>@item.Cantidad</td>
                        <td>$@item.PrecioUnitario</td>
                        <td>$@(item.PrecioUnitario * item.Cantidad)</td>
                    </tr>
                }
            </tbody>
        </table>
        <hr />
        <div class="sa-ticket-total">
            <span>TOTAL:</span>
            <strong>$@ultimaVenta.Total</strong>
        </div>
        <div class="sa-ticket-pago">
            Método de pago: @ultimaVenta.MetodoPago
        </div>
        <hr />
        <p class="sa-ticket-footer">¡Gracias por su compra!</p>
        <div class="sa-no-print" style="display:flex;gap:10px;margin-top:14px;">
            <button class="sa-btn sa-btn--primary" @onclick="Imprimir">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                Imprimir ticket
            </button>
            <button class="sa-btn sa-btn--secondary" @onclick="CerrarTicket">Cerrar</button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback sa-print-hide @(mensaje.StartsWith("❌") ? "sa-feedback--error" : "sa-feedback--ok")">@mensaje</div>
}

@code {
    private List<ProductoDto> productos = new();
    private List<VentaItem> items = new();
    private string metodoPago = "efectivo";
    private int productoSeleccionadoId = 0;
    private int cantidadSeleccionada = 1;
    private bool cajaAbierta = false;
    private string mensaje = string.Empty;
    private TicketData? ultimaVenta;

    private string nombreNegocio = "StockApp";
    private string direccionNegocio = string.Empty;
    private string telefonoNegocio = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos") ?? new();

        try
        {
            var caja = await Http.GetFromJsonAsync<object>("cajas/actual");
            cajaAbierta = caja != null;
        }
        catch
        {
            cajaAbierta = false;
        }

        try
        {
            var nombre = await Http.GetFromJsonAsync<ConfigDto>("configuracion/NombreNegocio");
            var direccion = await Http.GetFromJsonAsync<ConfigDto>("configuracion/DireccionNegocio");
            var telefono = await Http.GetFromJsonAsync<ConfigDto>("configuracion/TelefonoNegocio");

            nombreNegocio = !string.IsNullOrEmpty(nombre?.Valor) ? nombre!.Valor : "StockApp";
            direccionNegocio = direccion?.Valor ?? string.Empty;
            telefonoNegocio = telefono?.Valor ?? string.Empty;
        }
        catch { }
    }

    private void AgregarItem()
    {
        if (productoSeleccionadoId == 0 || cantidadSeleccionada <= 0) return;

        var producto = productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);
        if (producto == null) return;

        var existente = items.FirstOrDefault(i => i.ProductoId == productoSeleccionadoId);
        if (existente != null)
        {
            existente.Cantidad += cantidadSeleccionada;
        }
        else
        {
            items.Add(new VentaItem
            {
                ProductoId = producto.Id,
                NombreProducto = producto.Nombre,
                PrecioUnitario = producto.PrecioVenta,
                Cantidad = cantidadSeleccionada
            });
        }

        productoSeleccionadoId = 0;
        cantidadSeleccionada = 1;
    }

    private void QuitarItem(VentaItem item)
    {
        items.Remove(item);
    }

    private async Task RegistrarVenta()
    {
        if (!items.Any()) return;

        var request = new
        {
            MetodoPago = metodoPago,
            Items = items.Select(i => new { i.ProductoId, i.Cantidad }).ToList()
        };

        var response = await Http.PostAsJsonAsync("ventas", request);

        if (response.IsSuccessStatusCode)
        {
            ultimaVenta = new TicketData
            {
                Fecha = DateTime.Now,
                MetodoPago = metodoPago,
                Total = items.Sum(i => i.PrecioUnitario * i.Cantidad),
                Items = items.ToList()
            };

            mensaje = $"✅ Venta registrada por ${ultimaVenta.Total}";
            items.Clear();
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos") ?? new();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"❌ {error}";
        }
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("imprimirTicket");
    }

    private void CerrarTicket()
    {
        ultimaVenta = null;
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
    }

    public class VentaItem
    {
        public int ProductoId { get; set; }
        public string NombreProducto { get; set; } = string.Empty;
        public decimal PrecioUnitario { get; set; }
        public int Cantidad { get; set; }
    }

    public class TicketData
    {
        public DateTime Fecha { get; set; }
        public string MetodoPago { get; set; } = string.Empty;
        public decimal Total { get; set; }
        public List<VentaItem> Items { get; set; } = new();
    }

    public class ConfigDto
    {
        public string Clave { get; set; } = string.Empty;
        public string Valor { get; set; } = string.Empty;
    }
}