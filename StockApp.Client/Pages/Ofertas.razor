@page "/ofertas"
@inject HttpClient Http
<AdminOnly>

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.2H4a2 2 0 0 0-2 2v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.82 0l6.6-6.6a2 2 0 0 0 0-2.78Z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
        </span>
        <div>
            <h1>Ofertas y descuentos</h1>
            <div class="sa-page-sub">Precios especiales por producto</div>
        </div>
    </div>
</div>

<div class="sa-card" style="max-width:620px;margin-bottom:24px;">
    <div class="sa-card-title" style="margin-bottom:16px;">Aplicar descuento a un producto</div>

    <div class="sa-field">
        <label class="sa-label">Producto</label>
        <select class="sa-select" @bind="productoSeleccionadoId">
            <option value="0">-- Seleccioná un producto --</option>
            @foreach (var p in productos)
            {
                <option value="@p.Id">@p.Nombre — Precio actual: $@p.PrecioVenta</option>
            }
        </select>
    </div>

    <div class="sa-option-cards">
        <div class="sa-option-card @(modo == "descuento" ? "is-active" : "")" @onclick='() => modo = "descuento"'>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
            Descuento por porcentaje
        </div>
        <div class="sa-option-card @(modo == "oferta" ? "is-active" : "")" @onclick='() => modo = "oferta"'>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.2H4a2 2 0 0 0-2 2v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.82 0l6.6-6.6a2 2 0 0 0 0-2.78Z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
            Precio especial fijo
        </div>
    </div>

    @if (modo == "descuento")
    {
        <div class="sa-field">
            <label class="sa-label">Porcentaje de descuento</label>
            <div class="sa-input-symbol">
                <input class="sa-input" type="number" @bind="porcentaje" min="1" max="99" />
                <span>%</span>
            </div>
        </div>

        @if (productoSeleccionadoId > 0 && porcentaje > 0)
        {
            var producto = productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);
            if (producto != null)
            {
                var precioConDescuento = Math.Round(producto.PrecioVenta - (producto.PrecioVenta * (porcentaje / 100)), 2);
                <div class="sa-preview-box">
                    Precio actual: <strong>$@producto.PrecioVenta</strong> →
                    Precio con descuento: <strong style="color:var(--sa-ok-ink);">$@precioConDescuento</strong>
                </div>
            }
        }

        <button class="sa-btn sa-btn--primary sa-btn--lg" @onclick="AplicarDescuento">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Aplicar descuento
        </button>
    }
    else
    {
        <div class="sa-field">
            <label class="sa-label">Precio especial de oferta</label>
            <input class="sa-input" type="number" @bind="precioOferta" min="0" style="max-width:200px;" />
        </div>

        <button class="sa-btn sa-btn--primary sa-btn--lg" @onclick="AplicarOferta">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Aplicar precio de oferta
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(esError ? "sa-feedback--error" : "sa-feedback--ok")" style="max-width:620px;margin-bottom:24px;">@mensaje</div>
}

<div class="sa-card-title" style="margin-bottom:12px;">Lista de productos y precios actuales</div>
<div class="sa-card sa-card--flush">
    <table class="sa-table">
        <thead>
            <tr>
                <th>Producto</th>
                <th class="sa-right">Precio actual</th>
                <th class="sa-right">Costo</th>
                <th class="sa-right">Margen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in productos)
            {
                var margen = p.Costo > 0 ? Math.Round(((p.PrecioVenta - p.Costo) / p.Costo) * 100, 1) : 0;
                <tr>
                    <td class="sa-strong">@p.Nombre</td>
                    <td class="sa-right sa-num">$@p.PrecioVenta</td>
                    <td class="sa-right sa-num">$@p.Costo</td>
                    <td class="sa-right sa-num @(margen > 20 ? "sa-text-ok" : "sa-text-danger")">@margen%</td>
                </tr>
            }
        </tbody>
    </table>
</div>

</AdminOnly>

@code {
    private List<ProductoDto> productos = new();
    private string modo = "descuento";
    private int productoSeleccionadoId = 0;
    private decimal porcentaje = 0;
    private decimal precioOferta = 0;
    private string mensaje = string.Empty;
    private bool esError = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos") ?? new();
    }

    private async Task AplicarDescuento()
    {
        if (productoSeleccionadoId == 0 || porcentaje <= 0)
        {
            mensaje = "Seleccioná un producto y un porcentaje válido.";
            esError = true;
            return;
        }

        var response = await Http.PostAsJsonAsync($"productos/{productoSeleccionadoId}/descuento", porcentaje);

        if (response.IsSuccessStatusCode)
        {
            mensaje = "Descuento aplicado correctamente.";
            esError = false;
            productoSeleccionadoId = 0;
            porcentaje = 0;
            await CargarProductos();
        }
        else
        {
            mensaje = "Error al aplicar el descuento.";
            esError = true;
        }
    }

    private async Task AplicarOferta()
    {
        if (productoSeleccionadoId == 0 || precioOferta <= 0)
        {
            mensaje = "Seleccioná un producto y un precio válido.";
            esError = true;
            return;
        }

        var request = new { PrecioOferta = precioOferta };
        var response = await Http.PostAsJsonAsync($"productos/{productoSeleccionadoId}/oferta", request);

        if (response.IsSuccessStatusCode)
        {
            mensaje = "Precio de oferta aplicado correctamente.";
            esError = false;
            productoSeleccionadoId = 0;
            precioOferta = 0;
            await CargarProductos();
        }
        else
        {
            mensaje = "Error al aplicar la oferta.";
            esError = true;
        }
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal PrecioVenta { get; set; }
        public decimal Costo { get; set; }
    }
}