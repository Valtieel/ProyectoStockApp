@page "/cambiar-password"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </span>
        <div>
            <h1>Cambiar contraseña</h1>
            <div class="sa-page-sub">Actualizá tu contraseña de acceso</div>
        </div>
    </div>
</div>

<div class="sa-card" style="max-width:420px;">
    <div class="sa-field">
        <label class="sa-label">Email</label>
        <input class="sa-input" type="email" @bind="email" placeholder="Tu email" />
    </div>
    <div class="sa-field">
        <label class="sa-label">Contraseña actual</label>
        <input class="sa-input" type="password" @bind="passwordActual" placeholder="••••••••" />
    </div>
    <div class="sa-field">
        <label class="sa-label">Nueva contraseña</label>
        <input class="sa-input" type="password" @bind="passwordNueva" placeholder="••••••••" />
    </div>
    <div class="sa-field">
        <label class="sa-label">Confirmar nueva contraseña</label>
        <input class="sa-input" type="password" @bind="passwordConfirmar" placeholder="••••••••" />
        <small>Mínimo 6 caracteres.</small>
    </div>

    <button class="sa-btn sa-btn--primary sa-btn--lg" @onclick="ActualizarPassword">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Cambiar contraseña
    </button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(esError ? "sa-feedback--error" : "sa-feedback--ok")" style="max-width:420px;">@mensaje</div>
}

@code {
    private string email = string.Empty;
    private string passwordActual = string.Empty;
    private string passwordNueva = string.Empty;
    private string passwordConfirmar = string.Empty;
    private string mensaje = string.Empty;
    private bool esError = false;

    private async Task ActualizarPassword()
    {
        if (string.IsNullOrEmpty(email) ||
            string.IsNullOrEmpty(passwordActual) ||
            string.IsNullOrEmpty(passwordNueva) ||
            string.IsNullOrEmpty(passwordConfirmar))
        {
            mensaje = "❌ Completá todos los campos.";
            esError = true;
            return;
        }

        if (passwordNueva != passwordConfirmar)
        {
            mensaje = "❌ Las contraseñas nuevas no coinciden.";
            esError = true;
            return;
        }

        if (passwordNueva.Length < 6)
        {
            mensaje = "❌ La nueva contraseña debe tener al menos 6 caracteres.";
            esError = true;
            return;
        }

        var request = new
        {
            Email = email,
            PasswordActual = passwordActual,
            PasswordNueva = passwordNueva
        };

        var response = await Http.PutAsJsonAsync("auth/cambiar-password", request);

        if (response.IsSuccessStatusCode)
        {
            mensaje = "✅ Contraseña actualizada correctamente.";
            esError = false;
            email = string.Empty;
            passwordActual = string.Empty;
            passwordNueva = string.Empty;
            passwordConfirmar = string.Empty;
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"❌ {error}";
            esError = true;
        }
    }
}