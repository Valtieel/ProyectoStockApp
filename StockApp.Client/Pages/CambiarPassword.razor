@page "/cambiar-password"
@inject HttpClient Http
@inject IJSRuntime JS

<h3>🔑 Cambiar Contraseña</h3>

<div class="panel">
    <div class="campo">
        <label>Email</label>
        <input type="email" @bind="email" placeholder="Tu email" />
    </div>
    <div class="campo">
        <label>Contraseña actual</label>
        <input type="password" @bind="passwordActual" placeholder="••••••••" />
    </div>
    <div class="campo">
        <label>Nueva contraseña</label>
        <input type="password" @bind="passwordNueva" placeholder="••••••••" />
    </div>
    <div class="campo">
        <label>Confirmar nueva contraseña</label>
        <input type="password" @bind="passwordConfirmar" placeholder="••••••••" />
    </div>

    <button class="btn-guardar" @onclick="ActualizarPassword">🔑 Cambiar contraseña</button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <p class="mensaje @(esError ? "error" : "")">@mensaje</p>
}

@code {
    private string email = string.Empty;
    private string passwordActual = string.Empty;
    private string passwordNueva = string.Empty;
    private string passwordConfirmar = string.Empty;
    private string mensaje = string.Empty;
    private bool esError = false;

    private async Task ActualizarPassword()
    {
        if (string.IsNullOrEmpty(email) ||
            string.IsNullOrEmpty(passwordActual) ||
            string.IsNullOrEmpty(passwordNueva) ||
            string.IsNullOrEmpty(passwordConfirmar))
        {
            mensaje = "❌ Completá todos los campos.";
            esError = true;
            return;
        }

        if (passwordNueva != passwordConfirmar)
        {
            mensaje = "❌ Las contraseñas nuevas no coinciden.";
            esError = true;
            return;
        }

        if (passwordNueva.Length < 6)
        {
            mensaje = "❌ La nueva contraseña debe tener al menos 6 caracteres.";
            esError = true;
            return;
        }

        var request = new
        {
            Email = email,
            PasswordActual = passwordActual,
            PasswordNueva = passwordNueva
        };

        var response = await Http.PutAsJsonAsync("auth/cambiar-password", request);

        if (response.IsSuccessStatusCode)
        {
            mensaje = "✅ Contraseña actualizada correctamente.";
            esError = false;
            email = string.Empty;
            passwordActual = string.Empty;
            passwordNueva = string.Empty;
            passwordConfirmar = string.Empty;
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"❌ {error}";
            esError = true;
        }
    }
}

<style>
    h3 { margin-bottom: 1rem; }

    .panel {
        background: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 1.5rem;
        max-width: 400px;
        margin-bottom: 1.5rem;
    }

    .campo {
        margin-bottom: 0.8rem;
        display: flex;
        flex-direction: column;
    }

    .campo label {
        font-weight: 600;
        margin-bottom: 4px;
        font-size: 14px;
    }

    .campo input {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
    }

    .btn-guardar {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
        margin-top: 0.5rem;
    }

    .mensaje { font-weight: 600; color: #27ae60; margin-top: 1rem; }
    .mensaje.error { color: #e74c3c; }
</style>