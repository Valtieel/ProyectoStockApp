@page "/alertas"
@inject HttpClient Http

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        </span>
        <div>
            <h1>Alertas</h1>
            <div class="sa-page-sub">Stock bajo, vencimientos y productos vencidos</div>
        </div>
    </div>
</div>

@if (cargando)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else
{
    <div class="sa-grid-3" style="margin-bottom:24px;">
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico @(resumen?.StockBajo > 0 ? "sa-stat-ico--danger" : "sa-stat-ico--ok")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
            </span>
            <div>
                <div class="sa-stat-value" style="@(resumen?.StockBajo > 0 ? "color:#DC2626;" : "")">@resumen?.StockBajo</div>
                <div class="sa-stat-label">Stock bajo</div>
            </div>
        </div>
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico @(resumen?.PorVencer > 0 ? "sa-stat-ico--warn" : "sa-stat-ico--ok")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </span>
            <div>
                <div class="sa-stat-value" style="@(resumen?.PorVencer > 0 ? "color:var(--sa-warn-ink);" : "")">@resumen?.PorVencer</div>
                <div class="sa-stat-label">Por vencer (30 días)</div>
            </div>
        </div>
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico @(resumen?.Vencidos > 0 ? "sa-stat-ico--danger" : "sa-stat-ico--ok")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
            </span>
            <div>
                <div class="sa-stat-value" style="@(resumen?.Vencidos > 0 ? "color:#DC2626;" : "")">@resumen?.Vencidos</div>
                <div class="sa-stat-label">Vencidos</div>
            </div>
        </div>
    </div>

    @if (productosStockBajo.Any())
    {
        <div class="sa-card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:9px;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--sa-danger)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
            Productos con stock bajo
        </div>
        <div class="sa-card sa-card--flush" style="margin-bottom:24px;">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="sa-right">Stock actual</th>
                        <th class="sa-right">Stock mínimo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in productosStockBajo)
                    {
                        <tr class="sa-row--alert">
                            <td class="sa-strong">@p.Nombre</td>
                            <td class="sa-right sa-num">@p.StockActual</td>
                            <td class="sa-right sa-num">@p.StockMinimo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (productosPorVencer.Any())
    {
        <div class="sa-card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:9px;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--sa-warn-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Productos por vencer
        </div>
        <div class="sa-card sa-card--flush" style="margin-bottom:24px;">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="sa-right">Stock actual</th>
                        <th>Vencimiento</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in productosPorVencer)
                    {
                        <tr class="sa-row--warn">
                            <td class="sa-strong">@p.Nombre</td>
                            <td class="sa-right sa-num">@p.StockActual</td>
                            <td>@p.FechaVencimiento?.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (productosVencidos.Any())
    {
        <div class="sa-card-title" style="margin-bottom:12px;display:flex;align-items:center;gap:9px;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--sa-danger)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
            Productos vencidos
        </div>
        <div class="sa-card sa-card--flush" style="margin-bottom:24px;">
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="sa-right">Stock actual</th>
                        <th>Vencimiento</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in productosVencidos)
                    {
                        <tr class="sa-row--alert">
                            <td class="sa-strong">@p.Nombre</td>
                            <td class="sa-right sa-num">@p.StockActual</td>
                            <td>@p.FechaVencimiento?.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (resumen?.HayAlertas == false)
    {
        <div class="sa-alert-row" style="background:var(--sa-ok-soft);color:var(--sa-ok-ink);max-width:480px;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>Todo bien, no hay alertas por el momento.</span>
        </div>
    }
}

@code {
    private ResumenAlertas? resumen;
    private List<ProductoDto> productosStockBajo = new();
    private List<ProductoDto> productosPorVencer = new();
    private List<ProductoDto> productosVencidos = new();
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        resumen = await Http.GetFromJsonAsync<ResumenAlertas>("alertas/resumen");

        var stockBajoResp = await Http.GetFromJsonAsync<AlertaResponse>("alertas/stock-bajo");
        productosStockBajo = stockBajoResp?.Productos ?? new();

        var porVencerResp = await Http.GetFromJsonAsync<AlertaResponse>("alertas/por-vencer");
        productosPorVencer = porVencerResp?.Productos ?? new();

        var vencidosResp = await Http.GetFromJsonAsync<AlertaResponse>("alertas/vencidos");
        productosVencidos = vencidosResp?.Productos ?? new();

        cargando = false;
    }

    public class ResumenAlertas
    {
        public int StockBajo { get; set; }
        public int PorVencer { get; set; }
        public int Vencidos { get; set; }
        public bool HayAlertas { get; set; }
    }

    public class AlertaResponse
    {
        public int Cantidad { get; set; }
        public string Mensaje { get; set; } = string.Empty;
        public List<ProductoDto> Productos { get; set; } = new();
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public int StockActual { get; set; }
        public int StockMinimo { get; set; }
        public DateTime? FechaVencimiento { get; set; }
    }
}