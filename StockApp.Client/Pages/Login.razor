@using StockApp.Client.Services


@page "/login"
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-container">
    <div class="login-box">
        <h2>📦 StockApp</h2>
        <p class="subtitulo">Iniciá sesión para continuar</p>

        <div class="campo">
            <label>Email</label>
            <input type="email" @bind="email" placeholder="admin@stockapp.com" />
        </div>

        <div class="campo">
            <label>Contraseña</label>
            <input type="password" @bind="password" placeholder="••••••••" />
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }

        <button class="btn-login" @onclick="IniciarSesion">
            @if (cargando)
            {
                <span>Ingresando...</span>
            }
            else
            {
                <span>Ingresar</span>
            }
        </button>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string error = string.Empty;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        // Si ya está logueado redirigimos al inicio
        if (await Auth.EstaLogueado())
            Nav.NavigateTo("/");
    }

    private async Task IniciarSesion()
    {
        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
        {
            error = "Completá todos los campos.";
            return;
        }

        cargando = true;
        error = string.Empty;

        var request = new { Email = email, Password = password };
        var response = await Http.PostAsJsonAsync("auth/login", request);

        if (response.IsSuccessStatusCode)
        {
            var resultado = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (resultado != null)
            {
                await Auth.GuardarToken(resultado.Token);
                Nav.NavigateTo("/");
            }
        }
        else
        {
            error = "Email o contraseña incorrectos.";
        }

        cargando = false;
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
    }
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
    }

    .login-box {
        background: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 2rem;
        width: 100%;
        max-width: 400px;
        text-align: center;
    }

    h2 {
        font-size: 28px;
        margin-bottom: 0.5rem;
    }

    .subtitulo {
        color: #777;
        margin-bottom: 1.5rem;
        font-size: 15px;
    }

    .campo {
        margin-bottom: 1rem;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .campo label {
        font-weight: 600;
        font-size: 14px;
    }

    .campo input {
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 15px;
        width: 100%;
        box-sizing: border-box;
    }

    .btn-login {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        width: 100%;
        margin-top: 0.5rem;
    }

    .error {
        color: #e74c3c;
        font-size: 14px;
        margin-bottom: 0.5rem;
    }
</style>