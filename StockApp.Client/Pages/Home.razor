@page "/"
@inject HttpClient Http

<h3>🏠 Inicio</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (resumen != null)
{
    <p class="fecha">📅 @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>

    <div class="tarjetas">
        <div class="tarjeta @(resumen.CajaAbierta ? "verde" : "roja")">
            <span class="icono">🏧</span>
            <span class="numero">@(resumen.CajaAbierta ? "Abierta" : "Cerrada")</span>
            <span class="label">Caja</span>
        </div>
        <div class="tarjeta azul">
            <span class="icono">💰</span>
            <span class="numero">$@resumen.TotalVentasHoy</span>
            <span class="label">Ventas hoy</span>
        </div>
        <div class="tarjeta naranja">
            <span class="icono">🛒</span>
            <span class="numero">@resumen.CantidadVentasHoy</span>
            <span class="label">Transacciones hoy</span>
        </div>
        <div class="tarjeta gris">
            <span class="icono">📦</span>
            <span class="numero">@resumen.TotalProductos</span>
            <span class="label">Productos activos</span>
        </div>
    </div>

    @if (resumen.StockBajo > 0 || resumen.Vencidos > 0 || resumen.PorVencer > 0)
    {
        <h4>⚠️ Alertas pendientes</h4>
        <div class="alertas">
            @if (resumen.StockBajo > 0)
            {
                <div class="alerta roja">
                    📉 <strong>@resumen.StockBajo producto(s)</strong> con stock bajo
                </div>
            }
            @if (resumen.Vencidos > 0)
            {
                <div class="alerta roja">
                    ❌ <strong>@resumen.Vencidos producto(s)</strong> vencidos
                </div>
            }
            @if (resumen.PorVencer > 0)
            {
                <div class="alerta amarilla">
                    ⏳ <strong>@resumen.PorVencer producto(s)</strong> por vencer en 30 días
                </div>
            }
        </div>
    }
    else
    {
        <p class="todo-bien">✅ Todo en orden, no hay alertas pendientes.</p>
    }

    <div class="accesos">
        <h4>⚡ Accesos rápidos</h4>
        <div class="botones">
            <a href="/ventas" class="btn-acceso verde">💰 Nueva Venta</a>
            <a href="/productos" class="btn-acceso azul">📦 Productos</a>
            <a href="/caja" class="btn-acceso naranja">🏧 Caja</a>
            <a href="/balance" class="btn-acceso gris">📊 Balance</a>
        </div>
    </div>
}

@code {
    private ResumenHoy? resumen;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        resumen = await Http.GetFromJsonAsync<ResumenHoy>("balance/hoy");
        cargando = false;
    }

    public class ResumenHoy
    {
        public decimal TotalVentasHoy { get; set; }
        public int CantidadVentasHoy { get; set; }
        public bool CajaAbierta { get; set; }
        public int StockBajo { get; set; }
        public int Vencidos { get; set; }
        public int PorVencer { get; set; }
        public int TotalProductos { get; set; }
    }
}

<style>
    h3 { margin-bottom: 0.5rem; }
    h4 { margin-top: 1.5rem; margin-bottom: 0.8rem; }

    .fecha {
        color: #777;
        margin-bottom: 1.5rem;
        font-size: 15px;
    }

    .tarjetas {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .tarjeta {
        flex: 1;
        min-width: 140px;
        border-radius: 12px;
        padding: 1.2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .tarjeta.verde  { background-color: #eafaf1; border: 2px solid #2ecc71; }
    .tarjeta.roja   { background-color: #fdecea; border: 2px solid #e74c3c; }
    .tarjeta.azul   { background-color: #eaf4fb; border: 2px solid #3498db; }
    .tarjeta.naranja{ background-color: #fef5e7; border: 2px solid #e67e22; }
    .tarjeta.gris   { background-color: #f4f4f4; border: 2px solid #95a5a6; }

    .icono  { font-size: 28px; }
    .numero { font-size: 26px; font-weight: bold; }
    .label  { font-size: 13px; color: #555; }

    .alertas {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 1.5rem;
        max-width: 500px;
    }

    .alerta {
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 15px;
    }

    .alerta.roja    { background-color: #fdecea; border-left: 4px solid #e74c3c; }
    .alerta.amarilla{ background-color: #fef9e7; border-left: 4px solid #f1c40f; }

    .todo-bien {
        color: #27ae60;
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 1.5rem;
    }

    .accesos { margin-top: 1rem; }

    .botones {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-acceso {
        padding: 12px 24px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
    }

    .btn-acceso.verde  { background-color: #2ecc71; color: white; }
    .btn-acceso.azul   { background-color: #3498db; color: white; }
    .btn-acceso.naranja{ background-color: #e67e22; color: white; }
    .btn-acceso.gris   { background-color: #95a5a6; color: white; }
</style>