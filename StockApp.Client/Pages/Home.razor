@page "/"
@inject HttpClient Http

<div class="sa-page-head">
    <div class="sa-page-title">
        <div>
            <h1>Inicio</h1>
            <div class="sa-page-sub">@FechaHoy</div>
        </div>
    </div>
    <div class="sa-page-actions">
        <button class="sa-btn sa-btn--secondary" @onclick="CargarResumen">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
            Actualizar
        </button>
    </div>
</div>

@if (cargando)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (resumen != null)
{
    <!-- HERO -->
    <div class="sa-hero" style="margin-bottom:18px;position:relative;overflow:hidden;">
        <!-- gráfico decorativo de fondo -->
        <svg style="position:absolute;right:160px;bottom:0;opacity:.18;" width="220" height="100" viewBox="0 0 220 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polyline points="0,80 40,60 80,70 110,40 145,50 175,20 220,30" stroke="white" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div style="position:relative;">
            <div class="sa-hero-label">
                <span class="sa-hero-dot"></span>
                VENTAS DE HOY @(resumen.CajaAbierta ? "· EN VIVO" : "")
            </div>
            <div class="sa-hero-value">$@resumen.TotalVentasHoy.ToString("N0")</div>
            <div style="display:flex;align-items:center;gap:14px;margin-top:14px;">
                <span class="sa-hero-pill">@resumen.CantidadVentasHoy transacciones</span>
                <span style="font:500 13.5px var(--sa-font);color:var(--sa-primary-pale);">
                    Caja @(resumen.CajaAbierta ? "abierta" : "cerrada")
                </span>
            </div>
        </div>
        <div style="margin-left:auto;">
            <a href="/ventas" class="sa-btn sa-btn--on-hero">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                Nueva venta
            </a>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="sa-grid-4" style="margin-bottom:18px;">
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico @(resumen.CajaAbierta ? "sa-stat-ico--ok" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path></svg>
            </span>
            <div>
                <div class="sa-stat-value">@(resumen.CajaAbierta ? "Abierta" : "Cerrada")</div>
                <div class="sa-stat-label">Caja</div>
            </div>
        </div>
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
            </span>
            <div>
                <div class="sa-stat-value">@resumen.CantidadVentasHoy</div>
                <div class="sa-stat-label">Transacciones hoy</div>
            </div>
        </div>
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>
            </span>
            <div>
                <div class="sa-stat-value">@resumen.TotalProductos</div>
                <div class="sa-stat-label">Productos activos</div>
            </div>
        </div>
        <div class="sa-card sa-stat sa-lift" style="flex-direction:row;">
            <span class="sa-stat-ico @(resumen.StockBajo > 0 ? "sa-stat-ico--danger" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
            </span>
            <div>
                <div class="sa-stat-value" style="@(resumen.StockBajo > 0 ? "color:#DC2626;" : "")">@resumen.StockBajo</div>
                <div class="sa-stat-label">Con stock bajo</div>
            </div>
        </div>
    </div>

    <!-- FILA INFERIOR: Más vendidos + Alertas + Accesos rápidos -->
    <div style="display:grid;grid-template-columns:1fr 380px;gap:16px;align-items:start;">

        <!-- Más vendidos hoy -->
        <div class="sa-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
                <div class="sa-card-title">Más vendidos hoy</div>
                <a href="/historial-ventas" style="font:600 12.5px var(--sa-font);color:var(--sa-primary-hover);text-decoration:none;">Ver todo →</a>
            </div>
            @if (resumen.MasVendidosHoy == null || !resumen.MasVendidosHoy.Any())
            {
                <p style="color:var(--sa-sub);font-size:13.5px;">No hay ventas registradas hoy todavía.</p>
            }
            else
            {
                var max = resumen.MasVendidosHoy.Max(x => x.Cantidad);
                @foreach (var item in resumen.MasVendidosHoy)
                {
                    var pct = max > 0 ? (item.Cantidad * 100 / max) : 0;
                    <div class="sa-top-item">
                        <span class="sa-top-item-ico">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path></svg>
                        </span>
                        <div class="sa-top-item-body">
                            <div class="sa-top-item-name">@item.Nombre</div>
                            <div class="sa-top-item-bar">
                                <div class="sa-top-item-bar-fill" style="width:@pct%"></div>
                            </div>
                        </div>
                        <div class="sa-top-item-qty">@item.Cantidad <span style="font:500 11px var(--sa-font);color:var(--sa-sub);">u.</span></div>
                    </div>
                }
            }
        </div>

        <!-- Columna derecha: Alertas + Accesos rápidos -->
        <div style="display:flex;flex-direction:column;gap:16px;">

            <!-- Alertas pendientes -->
            <div class="sa-card">
                <div class="sa-card-title" style="margin-bottom:12px;">Alertas pendientes</div>
                @if (resumen.StockBajo == 0 && resumen.Vencidos == 0 && resumen.PorVencer == 0)
                {
                    <p style="color:var(--sa-sub);font-size:13.5px;">Sin alertas pendientes.</p>
                }
                else
                {
                    @if (resumen.StockBajo > 0)
                    {
                        <a href="/alertas" class="sa-alerta-pill sa-alerta-pill--danger">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
                            @resumen.StockBajo con stock bajo
                        </a>
                    }
                    @if (resumen.Vencidos > 0)
                    {
                        <a href="/alertas" class="sa-alerta-pill sa-alerta-pill--danger">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>
                            @resumen.Vencidos producto(s) vencidos
                        </a>
                    }
                    @if (resumen.PorVencer > 0)
                    {
                        <a href="/alertas" class="sa-alerta-pill sa-alerta-pill--warn">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            @resumen.PorVencer por vencer
                        </a>
                    }
                }
            </div>

            <!-- Accesos rápidos -->
            <div class="sa-card">
                <div class="sa-card-title" style="margin-bottom:12px;">Accesos rápidos</div>
                <div class="sa-quick-grid">
                    <a href="/ventas" class="sa-quick-card">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
                        Nueva venta
                    </a>
                    <a href="/productos" class="sa-quick-card">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>
                        Productos
                    </a>
                    <a href="/caja" class="sa-quick-card">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path></svg>
                        Caja
                    </a>
                    <a href="/balance" class="sa-quick-card">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line></svg>
                        Balance
                    </a>
                </div>
            </div>

        </div>
    </div>
}

@code {
    private ResumenHoy? resumen;
    private bool cargando = true;

    private static string FechaHoy
    {
        get
        {
            var texto = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy");
            return char.ToUpper(texto[0]) + texto.Substring(1);
        }
    }

    private async Task CargarResumen()
    {
        cargando = true;
        resumen = await Http.GetFromJsonAsync<ResumenHoy>("balance/hoy");
        cargando = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarResumen();
    }

    public class ResumenHoy
    {
        public decimal TotalVentasHoy { get; set; }
        public int CantidadVentasHoy { get; set; }
        public bool CajaAbierta { get; set; }
        public int StockBajo { get; set; }
        public int Vencidos { get; set; }
        public int PorVencer { get; set; }
        public int TotalProductos { get; set; }
        // ── NUEVO ──────────────────────────────────────────────────────────
        // Lista de productos más vendidos hoy (top 4), viene del backend.
        public List<MasVendidoDto> MasVendidosHoy { get; set; } = new();
    }

    public class MasVendidoDto
    {
        public string Nombre { get; set; } = string.Empty;
        public int Cantidad { get; set; }
    }
}