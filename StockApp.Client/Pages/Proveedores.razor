@page "/proveedores"
@inject HttpClient Http
@inject IJSRuntime JS

<AdminOnly>

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2Z"></path></svg>
        </span>
        <div>
            <h1>Proveedores</h1>
            <div class="sa-page-sub">Contactos y datos de compra</div>
        </div>
    </div>
    <div class="sa-page-actions">
        <button class="sa-btn sa-btn--primary" @onclick="MostrarFormulario">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            Nuevo proveedor
        </button>
    </div>
</div>

@if (mostrarFormulario)
{
    <div class="sa-card" style="margin-bottom:20px;max-width:520px;">
        <div class="sa-card-title" style="margin-bottom:16px;">
            @(proveedorEditando.Id == 0 ? "Nuevo proveedor" : "Editar proveedor")
        </div>
        <div class="sa-field">
            <label class="sa-label">Nombre</label>
            <input class="sa-input" @bind="proveedorEditando.Nombre" placeholder="Nombre del proveedor" />
        </div>
        <div class="sa-form-grid">
            <div class="sa-field">
                <label class="sa-label">Teléfono (opcional)</label>
                <input class="sa-input" @bind="proveedorEditando.Telefono" placeholder="Ej: 3464987654" />
            </div>
            <div class="sa-field">
                <label class="sa-label">Email (opcional)</label>
                <input class="sa-input" @bind="proveedorEditando.Email" placeholder="Ej: proveedor@mail.com" />
            </div>
            <div class="sa-field sa-field--full">
                <label class="sa-label">Dirección (opcional)</label>
                <input class="sa-input" @bind="proveedorEditando.Direccion" placeholder="Ej: Av. San Martín 456" />
            </div>
            <div class="sa-field sa-field--full">
                <label class="sa-label">Notas (opcional)</label>
                <input class="sa-input" @bind="proveedorEditando.Notas" placeholder="Ej: Entrega los martes" />
            </div>
        </div>
        <div style="display:flex;gap:10px;margin-top:6px;">
            <button class="sa-btn sa-btn--primary" @onclick="GuardarProveedor">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Guardar
            </button>
            <button class="sa-btn sa-btn--secondary" @onclick="CancelarFormulario">Cancelar</button>
        </div>
    </div>
}

<div class="sa-card" style="margin-bottom:16px;">
    <div class="sa-search" style="max-width:340px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar proveedor..." />
    </div>
</div>

@if (proveedores == null)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (!proveedores.Any())
{
    <p style="color:var(--sa-sub);">No hay proveedores registrados.</p>
}
else
{
    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Dirección</th>
                    <th>Notas</th>
                    <th class="sa-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in proveedores.Where(p =>
                    string.IsNullOrEmpty(textoBusqueda) ||
                    p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
                {
                    <tr>
                        <td class="sa-strong">@p.Nombre</td>
                        <td>@(p.Telefono ?? "-")</td>
                        <td>@(p.Email ?? "-")</td>
                        <td>@(p.Direccion ?? "-")</td>
                        <td>@(p.Notas ?? "-")</td>
                        <td class="sa-center">
                            <button class="sa-icbtn" title="Editar" @onclick="() => Editar(p)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                            </button>
                            <button class="sa-icbtn sa-icbtn--danger" title="Eliminar" @onclick="() => Eliminar(p.Id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(mensaje.StartsWith("❌") ? "sa-feedback--error" : "sa-feedback--ok")" style="max-width:520px;">@mensaje</div>
}

</AdminOnly>

@code {
    private List<ProveedorDto>? proveedores;
    private ProveedorDto proveedorEditando = new();
    private bool mostrarFormulario = false;
    private string mensaje = string.Empty;
    private string textoBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        proveedores = await Http.GetFromJsonAsync<List<ProveedorDto>>("proveedores");
    }

    private void MostrarFormulario()
    {
        proveedorEditando = new ProveedorDto();
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        proveedorEditando = new ProveedorDto();
    }

    private void Editar(ProveedorDto p)
    {
        proveedorEditando = new ProveedorDto
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Telefono = p.Telefono,
            Email = p.Email,
            Direccion = p.Direccion,
            Notas = p.Notas
        };
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarProveedor()
    {
        if (string.IsNullOrWhiteSpace(proveedorEditando.Nombre))
        {
            mensaje = "❌ El nombre del proveedor es obligatorio.";
            return;
        }

        proveedorEditando.Activo = true;

        if (proveedorEditando.Id == 0)
        {
            await Http.PostAsJsonAsync("proveedores", proveedorEditando);
            mensaje = "✅ Proveedor creado correctamente.";
        }
        else
        {
            await Http.PutAsJsonAsync($"proveedores/{proveedorEditando.Id}", proveedorEditando);
            mensaje = "✅ Proveedor actualizado correctamente.";
        }

        mostrarFormulario = false;
        await CargarProveedores();
    }

    private async Task Eliminar(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que querés eliminar este proveedor?");
        if (!confirmado) return;

        await Http.DeleteAsync($"proveedores/{id}");
        mensaje = "Proveedor eliminado.";
        await CargarProveedores();
    }

    public class ProveedorDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Telefono { get; set; }
        public string? Email { get; set; }
        public string? Direccion { get; set; }
        public string? Notas { get; set; }
        public bool Activo { get; set; } = true;
    }
}