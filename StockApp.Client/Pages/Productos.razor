@page "/productos"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>
        </span>
        <div>
            <h1>Productos</h1>
            <div class="sa-page-sub">Gestión de inventario</div>
        </div>
    </div>
    <div class="sa-page-actions">
        <a href="productos-eliminados" class="sa-btn sa-btn--secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            Ver eliminados
        </a>
        <button class="sa-btn sa-btn--primary" @onclick="MostrarFormulario">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            Nuevo producto
        </button>
    </div>
</div>

@if (mostrarFormulario)
{
    <div class="sa-card" style="margin-bottom:20px;max-width:680px;">
        <div class="sa-card-title" style="margin-bottom:16px;">
            @(productoEditando.Id == 0 ? "Nuevo producto" : "Editar producto")
        </div>

        <div class="sa-form-grid">
            <div class="sa-field sa-field--full">
                <label class="sa-label">Nombre</label>
                <input class="sa-input" @bind="productoEditando.Nombre" placeholder="Nombre del producto" />
            </div>
            <div class="sa-field sa-field--full">
                <label class="sa-label">Descripción</label>
                <input class="sa-input" @bind="productoEditando.Descripcion" placeholder="Descripción (opcional)" />
            </div>
            <div class="sa-field">
                <label class="sa-label">Categoría</label>
                <select class="sa-select" @bind="productoEditando.CategoriaId">
                    <option value="">-- Sin categoría --</option>
                    @foreach (var c in categorias)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="sa-field">
                <label class="sa-label">Proveedor (opcional)</label>
                <select class="sa-select" @bind="productoEditando.ProveedorId">
                    <option value="">-- Sin proveedor --</option>
                    @foreach (var p in proveedores)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </div>
            <div class="sa-field">
                <label class="sa-label">Precio de venta</label>
                <input class="sa-input" type="number" @bind="productoEditando.PrecioVenta" />
            </div>
            <div class="sa-field">
                <label class="sa-label">Costo</label>
                <input class="sa-input" type="number" @bind="productoEditando.Costo" />
            </div>
            <div class="sa-field">
                <label class="sa-label">Stock actual</label>
                <input class="sa-input" type="number" @bind="productoEditando.StockActual" />
            </div>
            <div class="sa-field">
                <label class="sa-label">Stock mínimo</label>
                <input class="sa-input" type="number" @bind="productoEditando.StockMinimo" />
            </div>
            <div class="sa-field sa-field--full">
                <label class="sa-label">Fecha de vencimiento (opcional)</label>
                <div class="sa-inline-fields">
                    <input class="sa-input" type="number" @bind="diaVencimiento" min="1" max="31" placeholder="Día" />
                    <input class="sa-input" type="number" @bind="mesVencimiento" min="1" max="12" placeholder="Mes" />
                    <input class="sa-input" type="number" @bind="anioVencimiento" min="2024" max="2099" placeholder="Año" />
                </div>
                <small>Formato: Día / Mes / Año</small>
            </div>
        </div>

        <div style="display:flex;gap:10px;margin-top:16px;">
            <button class="sa-btn sa-btn--primary" @onclick="GuardarProducto">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Guardar
            </button>
            <button class="sa-btn sa-btn--secondary" @onclick="CancelarFormulario">Cancelar</button>
        </div>
    </div>
}

<div class="sa-card" style="margin-bottom:16px;display:flex;gap:12px;align-items:center;">
    <div class="sa-search" style="max-width:none;flex:1;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar producto..." />
    </div>
    <select class="sa-select" style="width:auto;min-width:200px;" @bind="categoriaFiltro">
        <option value="0">Todas las categorías</option>
        @foreach (var c in categorias)
        {
            <option value="@c.Id">@c.Nombre</option>
        }
    </select>
</div>

@if (productos == null)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (!productos.Any())
{
    <p style="color:var(--sa-sub);">No hay productos cargados.</p>
}
else
{
    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Proveedor</th>
                    <th class="sa-right">Precio</th>
                    <th class="sa-right">Costo</th>
                    <th class="sa-right">Stock</th>
                    <th class="sa-right">Mínimo</th>
                    <th>Vencimiento</th>
                    <th class="sa-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in productos.Where(p =>
                    (string.IsNullOrEmpty(textoBusqueda) ||
                    p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) &&
                    (categoriaFiltro == 0 || p.CategoriaId == categoriaFiltro)))
                {
                    <tr class="@(p.StockActual <= p.StockMinimo ? "sa-row--alert" : "")">
                        <td class="sa-strong">@p.Nombre</td>
                        <td>@(p.CategoriaNombre ?? "-")</td>
                        <td>@(p.ProveedorNombre ?? "-")</td>
                        <td class="sa-right sa-num">$@p.PrecioVenta</td>
                        <td class="sa-right sa-num">$@p.Costo</td>
                        <td class="sa-right sa-num">@p.StockActual</td>
                        <td class="sa-right sa-num">@p.StockMinimo</td>
                        <td class="@ClaseVencimiento(p.FechaVencimiento)">@(p.FechaVencimiento.HasValue ? p.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "-")</td>
                        <td class="sa-center">
                            <button class="sa-icbtn" title="Editar" @onclick="() => Editar(p)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                            </button>
                            <button class="sa-icbtn sa-icbtn--danger" title="Eliminar" @onclick="() => Eliminar(p.Id)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(mensaje.StartsWith("❌") ? "sa-feedback--error" : "sa-feedback--ok")">@mensaje</div>
}

@code {
    // Determina el color del texto de vencimiento según qué tan cerca está:
    // rojo si ya venció, ámbar si vence dentro de los próximos 30 días.
    private string ClaseVencimiento(DateTime? fecha)
    {
        if (!fecha.HasValue) return "";

        if (fecha.Value.Date < DateTime.Today)
            return "sa-text-danger";

        if (fecha.Value.Date <= DateTime.Today.AddDays(30))
            return "sa-text-warn";

        return "";
    }

    private List<Producto>? productos;
    private List<CategoriaDto> categorias = new();
    private List<ProveedorDto> proveedores = new();
    private Producto productoEditando = new();
    private bool mostrarFormulario = false;
    private string mensaje = string.Empty;
    private string textoBusqueda = string.Empty;
    private int categoriaFiltro = 0;

    private int? diaVencimiento;
    private int? mesVencimiento;
    private int? anioVencimiento;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("categorias") ?? new();
        proveedores = await Http.GetFromJsonAsync<List<ProveedorDto>>("proveedores") ?? new();
    }

    private async Task CargarProductos()
    {
        productos = await Http.GetFromJsonAsync<List<Producto>>("productos");
    }

    private void MostrarFormulario()
    {
        productoEditando = new Producto();
        diaVencimiento = null;
        mesVencimiento = null;
        anioVencimiento = null;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        productoEditando = new Producto();
        diaVencimiento = null;
        mesVencimiento = null;
        anioVencimiento = null;
    }

    private void Editar(Producto p)
    {
        productoEditando = new Producto
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Descripcion = p.Descripcion,
            CategoriaId = p.CategoriaId,
            ProveedorId = p.ProveedorId,
            PrecioVenta = p.PrecioVenta,
            Costo = p.Costo,
            StockActual = p.StockActual,
            StockMinimo = p.StockMinimo,
            FechaVencimiento = p.FechaVencimiento
        };

        diaVencimiento = p.FechaVencimiento?.Day;
        mesVencimiento = p.FechaVencimiento?.Month;
        anioVencimiento = p.FechaVencimiento?.Year;

        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarProducto()
    {
        if (string.IsNullOrWhiteSpace(productoEditando.Nombre))
        {
            mensaje = "❌ El nombre del producto es obligatorio.";
            return;
        }
        if (productoEditando.PrecioVenta <= 0)
        {
            mensaje = "❌ El precio de venta debe ser mayor a 0.";
            return;
        }
        if (productoEditando.Costo < 0)
        {
            mensaje = "❌ El costo no puede ser negativo.";
            return;
        }
        if (productoEditando.StockActual < 0)
        {
            mensaje = "❌ El stock no puede ser negativo.";
            return;
        }
        if (productoEditando.StockMinimo < 0)
        {
            mensaje = "❌ El stock mínimo no puede ser negativo.";
            return;
        }

        if (diaVencimiento.HasValue && mesVencimiento.HasValue && anioVencimiento.HasValue)
        {
            try
            {
                productoEditando.FechaVencimiento = new DateTime(
                    anioVencimiento.Value,
                    mesVencimiento.Value,
                    diaVencimiento.Value
                );
            }
            catch
            {
                mensaje = "❌ La fecha ingresada no es válida.";
                return;
            }
        }
        else
        {
            productoEditando.FechaVencimiento = null;
        }

        if (productoEditando.Id == 0)
        {
            await Http.PostAsJsonAsync("productos", productoEditando);
            mensaje = "✅ Producto creado correctamente.";
        }
        else
        {
            await Http.PutAsJsonAsync($"productos/{productoEditando.Id}", productoEditando);
            mensaje = "✅ Producto actualizado correctamente.";
        }

        mostrarFormulario = false;
        diaVencimiento = null;
        mesVencimiento = null;
        anioVencimiento = null;
        await CargarProductos();
    }

    private async Task Eliminar(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que querés eliminar este producto?");
        if (!confirmado) return;

        await Http.DeleteAsync($"productos/{id}");
        mensaje = "Producto eliminado.";
        await CargarProductos();
    }

    public class Producto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Descripcion { get; set; }
        public int? CategoriaId { get; set; }
        public string? CategoriaNombre { get; set; }
        public int? ProveedorId { get; set; }
        public string? ProveedorNombre { get; set; }
        public decimal PrecioVenta { get; set; }
        public decimal Costo { get; set; }
        public int StockActual { get; set; }
        public int StockMinimo { get; set; }
        public DateTime? FechaVencimiento { get; set; }
    }

    public class CategoriaDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    public class ProveedorDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }
}