@page "/productos"
@inject IJSRuntime JS
@inject HttpClient Http

<h3>📦 Productos</h3>

<div class="acciones-top">
    <button class="btn-nuevo" @onclick="MostrarFormulario">+ Nuevo Producto</button>
    <a href="productos-eliminados" class="btn-eliminados">🗑️ Ver eliminados</a>
</div>

@if (mostrarFormulario)
{
    <div class="formulario">
        <h4>@(productoEditando.Id == 0 ? "Nuevo Producto" : "Editar Producto")</h4>
        <div class="campo">
            <label>Nombre</label>
            <input @bind="productoEditando.Nombre" placeholder="Nombre del producto" />
        </div>
        <div class="campo">
            <label>Descripción</label>
            <input @bind="productoEditando.Descripcion" placeholder="Descripción (opcional)" />
        </div>
        <div class="campo">
            <label>Categoría</label>
            <select @bind="productoEditando.CategoriaId">
                <option value="">-- Sin categoría --</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
        </div>
        <div class="campo">
            <label>Proveedor (opcional)</label>
            <select @bind="productoEditando.ProveedorId">
                <option value="">-- Sin proveedor --</option>
                @foreach (var p in proveedores)
                {
                    <option value="@p.Id">@p.Nombre</option>
                }
            </select>
        </div>
        <div class="campo">
            <label>Precio de venta</label>
            <input type="number" @bind="productoEditando.PrecioVenta" />
        </div>
        <div class="campo">
            <label>Costo</label>
            <input type="number" @bind="productoEditando.Costo" />
        </div>
        <div class="campo">
            <label>Stock actual</label>
            <input type="number" @bind="productoEditando.StockActual" />
        </div>
        <div class="campo">
            <label>Stock mínimo</label>
            <input type="number" @bind="productoEditando.StockMinimo" />
        </div>
        <div class="campo">
            <label>Fecha de vencimiento (opcional)</label>
            <div class="fecha-inputs">
                <input type="number" @bind="diaVencimiento" min="1" max="31" placeholder="Día" />
                <input type="number" @bind="mesVencimiento" min="1" max="12" placeholder="Mes" />
                <input type="number" @bind="anioVencimiento" min="2024" max="2099" placeholder="Año" />
            </div>
            <small>Formato: Día / Mes / Año</small>
        </div>
        <div class="botones">
            <button class="btn-guardar" @onclick="GuardarProducto">💾 Guardar</button>
            <button class="btn-cancelar" @onclick="CancelarFormulario">Cancelar</button>
        </div>
    </div>
}

<div class="buscador">
    <input @bind="textoBusqueda" @bind:event="oninput" placeholder="🔍 Buscar producto..." />
</div>

@if (productos == null)
{
    <p>Cargando...</p>
}
else if (!productos.Any())
{
    <p>No hay productos cargados.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Proveedor</th>
                <th>Precio</th>
                <th>Costo</th>
                <th>Stock</th>
                <th>Stock Mínimo</th>
                <th>Vencimiento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in productos.Where(p =>
                string.IsNullOrEmpty(textoBusqueda) ||
                p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
            {
                <tr class="@(p.StockActual <= p.StockMinimo ? "stock-bajo" : "")">
                    <td>@p.Nombre</td>
                    <td>@(p.CategoriaNombre ?? "-")</td>
                    <td>@(p.ProveedorNombre ?? "-")</td>
                    <td>$@p.PrecioVenta</td>
                    <td>$@p.Costo</td>
                    <td>@p.StockActual</td>
                    <td>@p.StockMinimo</td>
                    <td>@(p.FechaVencimiento.HasValue ? p.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td>
                        <button class="btn-editar" @onclick="() => Editar(p)">✏️</button>
                        <button class="btn-eliminar" @onclick="() => Eliminar(p.Id)">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <p class="mensaje">@mensaje</p>
}

@code {
    private List<Producto>? productos;
    private List<CategoriaDto> categorias = new();
    private List<ProveedorDto> proveedores = new();
    private Producto productoEditando = new();
    private bool mostrarFormulario = false;
    private string mensaje = string.Empty;
    private string textoBusqueda = string.Empty;

    private int? diaVencimiento;
    private int? mesVencimiento;
    private int? anioVencimiento;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("categorias") ?? new();
        proveedores = await Http.GetFromJsonAsync<List<ProveedorDto>>("proveedores") ?? new();
    }

    private async Task CargarProductos()
    {
        productos = await Http.GetFromJsonAsync<List<Producto>>("productos");
    }

    private void MostrarFormulario()
    {
        productoEditando = new Producto();
        diaVencimiento = null;
        mesVencimiento = null;
        anioVencimiento = null;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        productoEditando = new Producto();
        diaVencimiento = null;
        mesVencimiento = null;
        anioVencimiento = null;
    }

    private void Editar(Producto p)
    {
        productoEditando = new Producto
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Descripcion = p.Descripcion,
            CategoriaId = p.CategoriaId,
            ProveedorId = p.ProveedorId,
            PrecioVenta = p.PrecioVenta,
            Costo = p.Costo,
            StockActual = p.StockActual,
            StockMinimo = p.StockMinimo,
            FechaVencimiento = p.FechaVencimiento
        };

        diaVencimiento = p.FechaVencimiento?.Day;
        mesVencimiento = p.FechaVencimiento?.Month;
        anioVencimiento = p.FechaVencimiento?.Year;

        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarProducto()
    {
        if (diaVencimiento.HasValue && mesVencimiento.HasValue && anioVencimiento.HasValue)
        {
            try
            {
                productoEditando.FechaVencimiento = new DateTime(
                    anioVencimiento.Value,
                    mesVencimiento.Value,
                    diaVencimiento.Value
                );
            }
            catch
            {
                mensaje = "La fecha ingresada no es válida.";
                return;
            }
        }
        else
        {
            productoEditando.FechaVencimiento = null;
        }

        if (productoEditando.Id == 0)
        {
            await Http.PostAsJsonAsync("productos", productoEditando);
            mensaje = "Producto creado correctamente.";
        }
        else
        {
            await Http.PutAsJsonAsync($"productos/{productoEditando.Id}", productoEditando);
            mensaje = "Producto actualizado correctamente.";
        }

        mostrarFormulario = false;
        diaVencimiento = null;
        mesVencimiento = null;
        anioVencimiento = null;
        await CargarProductos();
    }

   private async Task Eliminar(int id)
{
    var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que querés eliminar este producto?");
    if (!confirmado) return;

    await Http.DeleteAsync($"productos/{id}");
    mensaje = "Producto eliminado.";
    await CargarProductos();
}
    public class Producto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Descripcion { get; set; }
        public int? CategoriaId { get; set; }
        public string? CategoriaNombre { get; set; }
        public int? ProveedorId { get; set; }
        public string? ProveedorNombre { get; set; }
        public decimal PrecioVenta { get; set; }
        public decimal Costo { get; set; }
        public int StockActual { get; set; }
        public int StockMinimo { get; set; }
        public DateTime? FechaVencimiento { get; set; }
    }

    public class CategoriaDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    public class ProveedorDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }
}

<style>
    h3 { margin-bottom: 1rem; }

    .acciones-top {
        display: flex;
        gap: 10px;
        margin-bottom: 1rem;
        align-items: center;
    }

    .btn-nuevo {
        background-color: #2ecc71;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
    }

    .btn-eliminados {
        display: inline-block;
        padding: 10px 20px;
        background-color: #95a5a6;
        color: white;
        border-radius: 8px;
        font-size: 15px;
        text-decoration: none;
    }

    .buscador {
        margin-bottom: 1rem;
    }

    .buscador input {
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 15px;
        width: 300px;
    }

    .formulario {
        background: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        max-width: 500px;
    }

    .campo {
        margin-bottom: 0.8rem;
        display: flex;
        flex-direction: column;
    }

    .campo label {
        font-weight: 600;
        margin-bottom: 4px;
        font-size: 14px;
    }

    .campo input, .campo select {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
    }

    .campo small {
        color: #777;
        font-size: 12px;
        margin-top: 4px;
    }

    .fecha-inputs {
        display: flex;
        gap: 8px;
    }

    .fecha-inputs input {
        width: 70px;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
        text-align: center;
    }

    .botones {
        display: flex;
        gap: 10px;
        margin-top: 1rem;
    }

    .btn-guardar {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
    }

    .btn-cancelar {
        background-color: #95a5a6;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    th, td {
        padding: 10px 14px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    th {
        background-color: #f4f4f4;
        font-weight: 600;
    }

    tr:hover { background-color: #f9f9f9; }

    .stock-bajo {
        background-color: #ffe5e5;
        color: #c0392b;
        font-weight: bold;
    }

    .btn-editar, .btn-eliminar {
        border: none;
        background: none;
        cursor: pointer;
        font-size: 18px;
        padding: 4px;
    }

    .mensaje {
        margin-top: 1rem;
        font-weight: 600;
        color: #27ae60;
    }
</style>