@page "/movimientos"
@inject HttpClient Http

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg>
        </span>
        <div>
            <h1>Movimientos</h1>
            <div class="sa-page-sub">Entradas y salidas manuales de stock</div>
        </div>
    </div>
</div>

<div class="sa-card" style="margin-bottom:20px;max-width:560px;">
    <div class="sa-card-title" style="margin-bottom:16px;">Registrar movimiento</div>

    <div class="sa-field">
        <label class="sa-label">Tipo</label>
        <select class="sa-select" @bind="tipo">
            <option value="entrada">Entrada (reponer stock)</option>
            <option value="salida">Salida manual (rotura, vencimiento, etc.)</option>
        </select>
    </div>

    <div class="sa-field">
        <label class="sa-label">Producto</label>
        <select class="sa-select" @bind="productoSeleccionadoId">
            <option value="0">-- Seleccioná un producto --</option>
            @foreach (var p in productos)
            {
                <option value="@p.Id">@p.Nombre (Stock: @p.StockActual)</option>
            }
        </select>
    </div>

    <div class="sa-field">
        <label class="sa-label">Cantidad</label>
        <input class="sa-input" type="number" @bind="cantidad" min="1" />
    </div>

    <div class="sa-field">
        <label class="sa-label">Motivo (opcional)</label>
        <input class="sa-input" @bind="motivo" placeholder="Ej: Reposición de proveedor, mercadería rota..." />
    </div>

    <button class="sa-btn @(tipo == "entrada" ? "sa-btn--ok-soft" : "sa-btn--danger-soft") sa-btn--lg" @onclick="RegistrarMovimiento">
        @if (tipo == "entrada")
        {
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
            <span>Registrar entrada</span>
        }
        else
        {
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg>
            <span>Registrar salida</span>
        }
    </button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(esError ? "sa-feedback--error" : "sa-feedback--ok")" style="max-width:560px;">@mensaje</div>
}

@if (movimientos.Any())
{
    <div class="sa-card-title" style="margin:24px 0 12px;">Historial de movimientos</div>
    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Tipo</th>
                    <th class="sa-right">Cantidad</th>
                    <th>Motivo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in movimientos)
                {
                    <tr class="@(m.Tipo.Equals("entrada", StringComparison.OrdinalIgnoreCase) ? "sa-mov--pago" : "sa-mov--deuda")">
                        <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="sa-strong">@m.Producto?.Nombre</td>
                        <td>
                            @if (m.Tipo.Equals("entrada", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="sa-tipo-badge sa-tipo-badge--ok">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
                                    Entrada
                                </span>
                            }
                            else
                            {
                                <span class="sa-tipo-badge sa-tipo-badge--danger">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg>
                                    Salida
                                </span>
                            }
                        </td>
                        <td class="sa-right sa-num">@m.Cantidad</td>
                        <td>@(string.IsNullOrEmpty(m.Motivo) ? "-" : m.Motivo)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProductoDto> productos = new();
    private List<MovimientoDto> movimientos = new();
    private string tipo = "entrada";
    private int productoSeleccionadoId = 0;
    private int cantidad = 1;
    private string motivo = string.Empty;
    private string mensaje = string.Empty;
    private bool esError = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        productos = await Http.GetFromJsonAsync<List<ProductoDto>>("productos") ?? new();
        movimientos = await Http.GetFromJsonAsync<List<MovimientoDto>>("movimientos") ?? new();
    }

    private async Task RegistrarMovimiento()
    {
        if (productoSeleccionadoId == 0 || cantidad <= 0)
        {
            mensaje = "⚠️ Seleccioná un producto y una cantidad válida.";
            esError = true;
            return;
        }

        var request = new
        {
            ProductoId = productoSeleccionadoId,
            Cantidad = cantidad,
            Motivo = motivo
        };

        HttpResponseMessage response;

        if (tipo == "entrada")
            response = await Http.PostAsJsonAsync("movimientos/entrada", request);
        else
            response = await Http.PostAsJsonAsync("movimientos/salida", request);

        if (response.IsSuccessStatusCode)
        {
            mensaje = tipo == "entrada"
                ? "✅ Entrada registrada correctamente."
                : "✅ Salida registrada correctamente.";
            esError = false;
            productoSeleccionadoId = 0;
            cantidad = 1;
            motivo = string.Empty;
            await CargarDatos();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"❌ {error}";
            esError = true;
        }
    }

    public class ProductoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public int StockActual { get; set; }
    }

    public class MovimientoDto
    {
        public int Id { get; set; }
        public int ProductoId { get; set; }
        public string Tipo { get; set; } = string.Empty;
        public int Cantidad { get; set; }
        public string? Motivo { get; set; }
        public DateTime Fecha { get; set; }
        public ProductoDto? Producto { get; set; }
    }
}