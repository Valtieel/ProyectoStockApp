@page "/usuarios"
@inject HttpClient Http
@inject IJSRuntime JS
<AdminOnly>

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"></circle><path d="M20 21a8 8 0 0 0-16 0"></path></svg>
        </span>
        <div>
            <h1>Usuarios</h1>
            <div class="sa-page-sub">Administradores y empleados</div>
        </div>
    </div>
    <div class="sa-page-actions">
        <button class="sa-btn sa-btn--primary" @onclick="MostrarFormulario">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            Nuevo usuario
        </button>
    </div>
</div>

@if (mostrarFormulario)
{
    <div class="sa-card" style="margin-bottom:20px;max-width:480px;">
        <div class="sa-card-title" style="margin-bottom:16px;">Nuevo usuario</div>
        <div class="sa-field">
            <label class="sa-label">Nombre</label>
            <input class="sa-input" @bind="nuevoUsuario.Nombre" placeholder="Nombre completo" />
        </div>
        <div class="sa-field">
            <label class="sa-label">Email</label>
            <input class="sa-input" type="email" @bind="nuevoUsuario.Email" placeholder="email@ejemplo.com" />
        </div>
        <div class="sa-field">
            <label class="sa-label">Contraseña</label>
            <input class="sa-input" type="password" @bind="nuevoUsuario.Password" placeholder="••••••••" />
        </div>
        <div class="sa-field">
            <label class="sa-label">Rol</label>
            <select class="sa-select" @bind="nuevoUsuario.Rol">
                <option value="empleado">Empleado</option>
                <option value="admin">Administrador</option>
            </select>
        </div>
        <div style="display:flex;gap:10px;margin-top:6px;">
            <button class="sa-btn sa-btn--primary" @onclick="CrearUsuario">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Guardar
            </button>
            <button class="sa-btn sa-btn--secondary" @onclick="CancelarFormulario">Cancelar</button>
        </div>
    </div>
}

@if (usuarios == null)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (!usuarios.Any())
{
    <p style="color:var(--sa-sub);">No hay usuarios registrados.</p>
}
else
{
    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Fecha creación</th>
                    <th class="sa-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in usuarios)
                {
                    <tr class="@(!u.Activo ? "sa-row--inactivo" : "")">
                        <td class="sa-strong">@u.Nombre</td>
                        <td>@u.Email</td>
                        <td>
                            <span class="sa-tipo-badge @(u.Rol == "admin" ? "sa-tipo-badge--danger" : "sa-tipo-badge--info")">
                                @u.Rol
                            </span>
                        </td>
                        <td>
                            <span class="sa-tipo-badge @(u.Activo ? "sa-tipo-badge--ok" : "sa-tipo-badge--neutral")">
                                @(u.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="sa-center">
                            <button class="sa-btn sa-btn--sm @(u.Activo ? "sa-btn--danger-soft" : "sa-btn--ok-soft")"
                                    @onclick="() => ToggleUsuario(u.Id)">
                                @if (u.Activo)
                                {
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                    <span>Desactivar</span>
                                }
                                else
                                {
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                                    <span>Activar</span>
                                }
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(mensaje.StartsWith("Error") ? "sa-feedback--error" : "sa-feedback--ok")" style="max-width:480px;">@mensaje</div>
}
</AdminOnly>
@code {
    private List<UsuarioDto>? usuarios;
    private NuevoUsuarioForm nuevoUsuario = new();
    private bool mostrarFormulario = false;
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        usuarios = await Http.GetFromJsonAsync<List<UsuarioDto>>("auth/usuarios");
    }

    private void MostrarFormulario()
    {
        nuevoUsuario = new NuevoUsuarioForm();
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        nuevoUsuario = new NuevoUsuarioForm();
    }

    private async Task CrearUsuario()
    {
        if (string.IsNullOrEmpty(nuevoUsuario.Nombre) ||
            string.IsNullOrEmpty(nuevoUsuario.Email) ||
            string.IsNullOrEmpty(nuevoUsuario.Password))
        {
            mensaje = "Completá todos los campos obligatorios.";
            return;
        }

        var request = new
        {
            nuevoUsuario.Nombre,
            nuevoUsuario.Email,
            nuevoUsuario.Password,
            nuevoUsuario.Rol
        };

        var response = await Http.PostAsJsonAsync("auth/registro", request);

        if (response.IsSuccessStatusCode)
        {
            mensaje = "Usuario creado correctamente.";
            mostrarFormulario = false;
            await CargarUsuarios();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"Error: {error}";
        }
    }

    private async Task ToggleUsuario(int id)
    {
        var usuario = usuarios?.FirstOrDefault(u => u.Id == id);
        if (usuario == null) return;

        var accion = usuario.Activo ? "desactivar" : "activar";
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Seguro que querés {accion} este usuario?");
        if (!confirmado) return;

        var response = await Http.PutAsJsonAsync($"auth/usuarios/{id}/toggle", new { });
        if (response.IsSuccessStatusCode)
        {
            await CargarUsuarios();
        }
    }

    public class UsuarioDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public bool Activo { get; set; }
        public DateTime FechaCreacion { get; set; }
    }

    public class NuevoUsuarioForm
    {
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Rol { get; set; } = "empleado";
    }
}