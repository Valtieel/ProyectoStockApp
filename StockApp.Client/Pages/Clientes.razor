    }

    .panel-cuenta {
        background: #f9f9f9;
        border: 2px solid #3498db;
        border-radius: 10px;
        padding: 1.5rem;
        margin-top: 1.5rem;
    }

    .saldo { font-size: 16px; margin-bottom: 1rem; }

    .acciones-cuenta {
        background: white;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .btn-deuda {
        background-color: #e74c3c;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
    }

    .btn-pago {
        background-color: #2ecc71;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 15px;
        cursor: pointer;
    }

    .fila-deuda { background-color: #fdecea; }
    .fila-pago { background-color: #eafaf1; }

    .mensaje {
        margin-top: 1rem;
        font-weight: 600;
        color: #27ae60;
    }
</style>