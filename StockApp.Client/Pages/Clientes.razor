@page "/clientes"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="sa-page-head">
    <div class="sa-page-title">
        <span class="sa-page-ico">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </span>
        <div>
            <h1>Clientes</h1>
            <div class="sa-page-sub">Cuentas corrientes y contactos</div>
        </div>
    </div>
    <div class="sa-page-actions">
        <button class="sa-btn sa-btn--primary" @onclick="MostrarFormulario">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            Nuevo cliente
        </button>
    </div>
</div>

@if (mostrarFormulario)
{
    <div class="sa-card" style="margin-bottom:20px;max-width:500px;">
        <div class="sa-card-title" style="margin-bottom:16px;">
            @(clienteEditando.Id == 0 ? "Nuevo cliente" : "Editar cliente")
        </div>
        <div class="sa-field">
            <label class="sa-label">Nombre</label>
            <input class="sa-input" @bind="clienteEditando.Nombre" placeholder="Nombre del cliente" />
        </div>
        <div class="sa-field">
            <label class="sa-label">Teléfono (opcional)</label>
            <input class="sa-input" @bind="clienteEditando.Telefono" placeholder="Ej: 3464123456" />
        </div>
        <div class="sa-field">
            <label class="sa-label">Dirección (opcional)</label>
            <input class="sa-input" @bind="clienteEditando.Direccion" placeholder="Ej: San Martín 123" />
        </div>
        <div style="display:flex;gap:10px;margin-top:6px;">
            <button class="sa-btn sa-btn--primary" @onclick="GuardarCliente">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Guardar
            </button>
            <button class="sa-btn sa-btn--secondary" @onclick="CancelarFormulario">Cancelar</button>
        </div>
    </div>
}

<div class="sa-card" style="margin-bottom:16px;">
    <div class="sa-search" style="max-width:340px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar cliente..." />
    </div>
</div>

@if (clientes == null)
{
    <p style="color:var(--sa-sub);">Cargando...</p>
}
else if (!clientes.Any())
{
    <p style="color:var(--sa-sub);">No hay clientes registrados.</p>
}
else
{
    <div class="sa-card sa-card--flush">
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th class="sa-right">Saldo deudor</th>
                    <th class="sa-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clientes.Where(c =>
                    string.IsNullOrEmpty(textoBusqueda) ||
                    c.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                    (c.Telefono != null && c.Telefono.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))))
                {
                    <tr class="@(c.SaldoDeudor > 0 ? "sa-row--warn" : "")">
                        <td class="sa-strong">@c.Nombre</td>
                        <td>@(c.Telefono ?? "-")</td>
                        <td>@(c.Direccion ?? "-")</td>
                        <td class="sa-right sa-num @(c.SaldoDeudor > 0 ? "sa-text-danger" : "")">
                            $@c.SaldoDeudor
                        </td>
                        <td class="sa-center">
                            <button class="sa-btn sa-btn--soft sa-btn--sm" @onclick="() => VerCuenta(c.Id)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                                Cuenta
                            </button>
                            <button class="sa-icbtn" title="Editar" @onclick="() => Editar(c)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                            </button>
                            <button class="sa-icbtn sa-icbtn--danger" title="Eliminar" @onclick="() => Eliminar(c.Id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (clienteSeleccionado != null)
{
    <div class="sa-card" style="margin-top:20px;border:1.5px solid var(--sa-primary-lighter);">
        <div class="sa-card-title" style="margin-bottom:6px;">
            Cuenta corriente — @clienteSeleccionado.Nombre
        </div>
        <p style="font:600 15px var(--sa-font);color:@(clienteSeleccionado.SaldoDeudor > 0 ? "var(--sa-danger-ink)" : "var(--sa-ok-ink)");margin:8px 0 16px;">
            Saldo deudor: <strong>$@clienteSeleccionado.SaldoDeudor</strong>
        </p>

        <div class="sa-card" style="box-shadow:none;border:1px solid var(--sa-border);margin-bottom:16px;">
            <div class="sa-form-grid">
                <div class="sa-field">
                    <label class="sa-label">Monto</label>
                    <input class="sa-input" type="number" @bind="montoOperacion" min="0" />
                </div>
                <div class="sa-field">
                    <label class="sa-label">Descripción (opcional)</label>
                    <input class="sa-input" @bind="descripcionOperacion" placeholder="Ej: Compra del día, pago parcial..." />
                </div>
            </div>
            <div style="display:flex;gap:10px;">
                <button class="sa-btn sa-btn--danger-soft" @onclick="RegistrarDeuda">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                    Cargar deuda
                </button>
                <button class="sa-btn sa-btn--ok-soft" @onclick="RegistrarPago">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    Registrar pago
                </button>
            </div>
        </div>

        @if (movimientos.Any())
        {
            <div class="sa-card sa-card--flush" style="box-shadow:none;border:1px solid var(--sa-border);">
                <table class="sa-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th class="sa-right">Monto</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in movimientos)
                        {
                            <tr class="@(m.Tipo == "deuda" ? "sa-mov--deuda" : "sa-mov--pago")">
                                <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(m.Tipo == "deuda" ? "Deuda" : "Pago")</td>
                                <td class="sa-right sa-num">$@m.Monto</td>
                                <td>@(string.IsNullOrEmpty(m.Descripcion) ? "-" : m.Descripcion)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="sa-feedback @(mensaje.StartsWith("❌") ? "sa-feedback--error" : "sa-feedback--ok")">@mensaje</div>
}

@code {
    private List<ClienteDto>? clientes;
    private ClienteDto clienteEditando = new();
    private ClienteDto? clienteSeleccionado;
    private List<MovimientoDto> movimientos = new();
    private bool mostrarFormulario = false;
    private string mensaje = string.Empty;
    private decimal montoOperacion = 0;
    private string descripcionOperacion = string.Empty;
    private string textoBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        var lista = await Http.GetFromJsonAsync<List<ClienteConSaldo>>("clientes") ?? new();
        clientes = new List<ClienteDto>();

        foreach (var c in lista)
        {
            var detalle = await Http.GetFromJsonAsync<ClienteConSaldo>($"clientes/{c.Id}");
            if (detalle != null)
            {
                clientes.Add(new ClienteDto
                {
                    Id = detalle.Id,
                    Nombre = detalle.Nombre,
                    Telefono = detalle.Telefono,
                    Direccion = detalle.Direccion,
                    SaldoDeudor = detalle.SaldoDeudor
                });
            }
        }
    }

    private void MostrarFormulario()
    {
        clienteEditando = new ClienteDto();
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        clienteEditando = new ClienteDto();
    }

    private void Editar(ClienteDto c)
    {
        clienteEditando = new ClienteDto
        {
            Id = c.Id,
            Nombre = c.Nombre,
            Telefono = c.Telefono,
            Direccion = c.Direccion
        };
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarCliente()
    {
        if (string.IsNullOrWhiteSpace(clienteEditando.Nombre))
        {
            mensaje = "❌ El nombre del cliente es obligatorio.";
            return;
        }

        clienteEditando.Activo = true;

        if (clienteEditando.Id == 0)
        {
            await Http.PostAsJsonAsync("clientes", clienteEditando);
            mensaje = "✅ Cliente creado correctamente.";
        }
        else
        {
            await Http.PutAsJsonAsync($"clientes/{clienteEditando.Id}", clienteEditando);
            mensaje = "✅ Cliente actualizado correctamente.";
        }

        mostrarFormulario = false;
        await CargarClientes();
    }

    private async Task Eliminar(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que querés eliminar este cliente?");
        if (!confirmado) return;

        await Http.DeleteAsync($"clientes/{id}");
        mensaje = "Cliente eliminado.";
        clienteSeleccionado = null;
        await CargarClientes();
    }

    private async Task VerCuenta(int id)
    {
        var detalle = await Http.GetFromJsonAsync<CuentaResponse>($"clientes/{id}/cuenta");
        if (detalle != null)
        {
            clienteSeleccionado = clientes?.FirstOrDefault(c => c.Id == id);
            if (clienteSeleccionado != null)
                clienteSeleccionado.SaldoDeudor = detalle.SaldoDeudor;
            movimientos = detalle.Movimientos;
        }
        montoOperacion = 0;
        descripcionOperacion = string.Empty;
    }

    private async Task RegistrarDeuda()
    {
        if (clienteSeleccionado == null || montoOperacion <= 0) return;

        var request = new { Monto = montoOperacion, Descripcion = descripcionOperacion };
        await Http.PostAsJsonAsync($"clientes/{clienteSeleccionado.Id}/deuda", request);
        mensaje = "✅ Deuda registrada correctamente.";
        await VerCuenta(clienteSeleccionado.Id);
        await CargarClientes();
    }

    private async Task RegistrarPago()
    {
        if (clienteSeleccionado == null || montoOperacion <= 0) return;

        var request = new { Monto = montoOperacion, Descripcion = descripcionOperacion };
        await Http.PostAsJsonAsync($"clientes/{clienteSeleccionado.Id}/pago", request);
        mensaje = "✅ Pago registrado correctamente.";
        await VerCuenta(clienteSeleccionado.Id);
        await CargarClientes();
    }

    public class ClienteDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Telefono { get; set; }
        public string? Direccion { get; set; }
        public decimal SaldoDeudor { get; set; }
        public bool Activo { get; set; } = true;
    }

    public class ClienteConSaldo
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Telefono { get; set; }
        public string? Direccion { get; set; }
        public decimal SaldoDeudor { get; set; }
    }

    public class CuentaResponse
    {
        public string Cliente { get; set; } = string.Empty;
        public decimal SaldoDeudor { get; set; }
        public List<MovimientoDto> Movimientos { get; set; } = new();
    }

    public class MovimientoDto
    {
        public int Id { get; set; }
        public string Tipo { get; set; } = string.Empty;
        public decimal Monto { get; set; }
        public string? Descripcion { get; set; }
        public DateTime Fecha { get; set; }
    }
}