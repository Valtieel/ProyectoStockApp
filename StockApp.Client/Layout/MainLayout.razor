@inherits LayoutComponentBase
@using StockApp.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="sa-app">
    @if (!Nav.Uri.Contains("/login"))
    {
        <NavMenu />
    }

    <main class="sa-main">
        <article class="sa-content">
            @Body
        </article>
    </main>
</div>