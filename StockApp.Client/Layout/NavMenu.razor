                </NavLink>
                <NavLink class="sa-nav-item" href="configuracion">
                    <i>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"></path></svg>
                    </i>
                    <span>Configuración</span>
                </NavLink>
                <NavLink class="sa-nav-item" href="cambiar-password">
                    <i>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </i>
                    <span>Cambiar contraseña</span>
                </NavLink>
            </div>
        }
    </nav>

    <div class="sa-profile">
        <div class="sa-profile-box">
            <span class="sa-avatar">@Iniciales</span>
            <div style="min-width:0;">
                <div class="sa-profile-name">@nombreUsuario</div>
                <div class="sa-profile-role">● @(rol == "admin" ? "Administrador" : "Empleado")</div>
            </div>
        </div>
    </div>
    <div class="sa-logout-wrap">
        <button class="sa-logout" @onclick="CerrarSesion">
            <i>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            </i>
            <span>Cerrar sesión</span>
        </button>
    </div>
</aside>

@code {
    private string nombreUsuario = string.Empty;
    private string rol = string.Empty;

    // Estado de colapso de cada grupo del menú. true = colapsado (cerrado).
    // Empiezan todos abiertos (false) por defecto.
    private Dictionary<string, bool> colapsado = new()
    {
        ["principal"] = false,
        ["operacion"] = false,
        ["admin"] = false
    };

    private bool EstaColapsado(string grupo) => colapsado.TryGetValue(grupo, out var v) && v;

    private void Toggle(string grupo)
    {
        colapsado[grupo] = !EstaColapsado(grupo);
    }

    // Cuando está abierto, "none" deja que el contenido defina su propia altura real
    // (sin espacio fantasma de más). Cuando está colapsado, baja a 0 para la animación.
    private string AltoGrupo(string grupo, int cantidadItems)
    {
        return EstaColapsado(grupo) ? "max-height:0px;" : "max-height:none;";
    }

    private string Iniciales =>
        string.IsNullOrWhiteSpace(nombreUsuario)
            ? "?"
            : string.Concat(nombreUsuario
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(p => p[0]))
              .ToUpper();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                var partes = token.Split('.');
                if (partes.Length == 3)
                {
                    var payload = partes[1];
                    payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
                    var bytes = Convert.FromBase64String(payload);
                    var json = System.Text.Encoding.UTF8.GetString(bytes);
                    var datos = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(json);

                    var nameKey = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name";
                    var roleKey = "http://schemas.microsoft.com/ws/2008/06/identity/claims/role";

                    if (datos != null)
                    {
                        if (datos.ContainsKey(nameKey))
                            nombreUsuario = datos[nameKey].GetString() ?? string.Empty;
                        if (datos.ContainsKey(roleKey))
                            rol = datos[roleKey].GetString() ?? string.Empty;
                    }
                }
            }
            StateHasChanged();
        }
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "token");
        Nav.NavigateTo("/login");
    }
}